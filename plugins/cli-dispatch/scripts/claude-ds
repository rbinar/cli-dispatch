#!/usr/bin/env bash
set -euo pipefail
# Config path: cli-dispatch dir, with legacy ~/.config/claude-ds fallback (env wins; CLI_DISPATCH_CONFIG preferred over the legacy CLAUDE_DS_CONFIG).
CONFIG="${CLI_DISPATCH_CONFIG:-${CLAUDE_DS_CONFIG:-}}"
[ -n "$CONFIG" ] || { CONFIG="$HOME/.config/cli-dispatch/config"; [ -f "$CONFIG" ] || [ ! -f "$HOME/.config/claude-ds/config" ] || CONFIG="$HOME/.config/claude-ds/config"; }
if [ -f "$CONFIG" ]; then
  # shellcheck disable=SC1090
  . "$CONFIG"
fi
if [ -z "${DEEPSEEK_API_KEY:-}" ]; then
  # A key set only in the plugin's userConfig is passed by the dispatch tool alone (flags file, never a value).
  if grep -q '"DEEPSEEK_API_KEY": *true' "${CLI_DISPATCH_USERCONFIG_STATUS:-${XDG_CONFIG_HOME:-$HOME/.config}/cli-dispatch/userconfig-status.json}" 2>/dev/null; then
    echo "claude-ds: DEEPSEEK_API_KEY is set in the plugin config, which only the dispatch tool passes to workers. Use the dispatch tool, or add the key to $CONFIG (or run the setup form: /cli-dispatch:setup)." >&2
  else
    echo "claude-ds: DEEPSEEK_API_KEY not set. Add it to $CONFIG (run /cli-dispatch:setup), or /plugin configure cli-dispatch@cli-dispatch for the dispatch tool." >&2
  fi
  exit 1
fi
exec env \
  ANTHROPIC_BASE_URL="https://api.deepseek.com/anthropic" \
  ANTHROPIC_AUTH_TOKEN="$DEEPSEEK_API_KEY" \
  ANTHROPIC_MODEL="${DS_MODEL:-deepseek-v4-pro}" \
  ANTHROPIC_DEFAULT_OPUS_MODEL="${DS_MODEL:-deepseek-v4-pro}" \
  ANTHROPIC_DEFAULT_SONNET_MODEL="${DS_MODEL:-deepseek-v4-pro}" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="${DS_FLASH_MODEL:-deepseek-flash}" \
  CLAUDE_CODE_SUBAGENT_MODEL="${DS_FLASH_MODEL:-deepseek-flash}" \
  claude "$@"
