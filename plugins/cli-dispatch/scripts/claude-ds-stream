#!/usr/bin/env bash
# claude-ds-stream — the stream-json + session-tracked variant of claude-ds.
#
# Runs `claude` with the DeepSeek env and the stream-json output format, piping
# stdout into ds-stream-parse.mjs. The parser writes transcript.jsonl /
# progress.log / status.json / meta.json to a session directory and prints the
# final text to stdout.
#
# Usage:
#   claude-ds-stream [--cwd <dir>] [--resume <id>] [--read-only] [--effort low|medium|high] \
#                    [--max-runtime <s>] [--idle-timeout <s>] -p "<prompt>" [extra claude flags]
#   echo "<prompt>" | claude-ds-stream [--cwd <dir>]
#
# --max-runtime <s>   kill the worker after <s> seconds total (0 = off, default)
# --idle-timeout <s>  kill the worker after <s> seconds with no new output (0 = off)
#   (env fallbacks: CLAUDE_DS_MAX_RUNTIME, CLAUDE_DS_IDLE_TIMEOUT)
# --effort <level>    thinking budget via MAX_THINKING_TOKENS (low=1024, medium=8192,
#                     high=31999). Best-effort: applied only if the DeepSeek
#                     Anthropic-compatible API honors the thinking budget.
#
# NOTE: by default the worker runs with --permission-mode bypassPermissions (the CLI
# can't prompt in non-interactive --print mode), so it CAN write files and run bash
# even without --dangerously-skip-permissions. This is delegation, not a sandbox —
# isolate real-repo work in a worktree. Pass --read-only for true read-only generation
# (denies Write/Edit/Bash so nothing is mutated on disk).
#
# Session directory: ${XDG_CACHE_HOME:-$HOME/.cache}/cli-dispatch/sessions/<id>/ (legacy: claude-ds)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$SCRIPT_DIR/stream-utils.sh"

# Config path: cli-dispatch dir, with legacy ~/.config/claude-ds fallback (env wins).
source_config

# Forward the host's gh auth (macOS keyring) into the worker env (issue #56).
maybe_export_gh_token

if [ -z "${DEEPSEEK_API_KEY:-}" ]; then
  echo "claude-ds-stream: DEEPSEEK_API_KEY not set. Add it to $CONFIG (run /cli-dispatch:setup)." >&2
  exit 1
fi

# Required for the node parser (claude-code already runs in a node environment).
if ! command -v node >/dev/null 2>&1; then
  echo "claude-ds-stream: 'node' not found in PATH (required for the stream parser)." >&2
  exit 1
fi

# Resolve the parser path: env > installed location > repo/script dir.
PARSER="${CLI_DISPATCH_PARSER:-${CLAUDE_DS_PARSER:-}}"
if [ -z "$PARSER" ]; then
  for cand in "$HOME/.local/share/cli-dispatch/ds-stream-parse.mjs" "$HOME/.local/share/claude-ds/ds-stream-parse.mjs" "$SCRIPT_DIR/ds-stream-parse.mjs"; do
    if [ -f "$cand" ]; then PARSER="$cand"; break; fi
  done
fi
if [ -z "$PARSER" ] || [ ! -f "$PARSER" ]; then
  echo "claude-ds-stream: ds-stream-parse.mjs not found (set CLAUDE_DS_PARSER)." >&2
  exit 1
fi

# ---- parse arguments ----
CWD="$(pwd)"
RESUME_ID=""
PROMPT=""
HAVE_PROMPT=0
READ_ONLY=0
EFFORT="${CLAUDE_DS_EFFORT:-}"
MAX_RUNTIME="${CLAUDE_DS_MAX_RUNTIME:-0}"     # seconds; 0 = no overall runtime cap
IDLE_TIMEOUT="${CLAUDE_DS_IDLE_TIMEOUT:-0}"   # seconds; 0 = no idle (no-output) cap
PASS_ARGS=()
# A value-consuming flag at the end of argv would read an unset $2 under `set -u`
# and crash cryptically; guard each with a $# check for a friendly message.
need_val() { [ "$2" -ge 2 ] || { echo "claude-ds-stream: $1 requires a value." >&2; exit 1; }; }
while [ "$#" -gt 0 ]; do
  case "$1" in
    --cwd)        need_val --cwd "$#";    CWD="$2"; shift 2;;
    --cwd=*)      CWD="${1#*=}"; shift;;
    --resume)     need_val --resume "$#"; RESUME_ID="$2"; shift 2;;
    --resume=*)   RESUME_ID="${1#*=}"; shift;;
    -p|--prompt)  need_val "$1" "$#";     PROMPT="$2"; HAVE_PROMPT=1; shift 2;;
    -p=*)         PROMPT="${1#*=}"; HAVE_PROMPT=1; shift;;
    --prompt=*)   PROMPT="${1#*=}"; HAVE_PROMPT=1; shift;;
    --read-only)  READ_ONLY=1; shift;;
    --effort)     need_val --effort "$#"; EFFORT="$2"; shift 2;;
    --effort=*)   EFFORT="${1#*=}"; shift;;
    --max-runtime)    need_val --max-runtime "$#";  MAX_RUNTIME="$2"; shift 2;;
    --max-runtime=*)  MAX_RUNTIME="${1#*=}"; shift;;
    --idle-timeout)   need_val --idle-timeout "$#"; IDLE_TIMEOUT="$2"; shift 2;;
    --idle-timeout=*) IDLE_TIMEOUT="${1#*=}"; shift;;
    *)            PASS_ARGS+=("$1"); shift;;
  esac
done

# No prompt → read from stdin (pipe support).
if [ "$HAVE_PROMPT" -eq 0 ]; then
  if [ ! -t 0 ]; then
    PROMPT="$(cat)"
  else
    echo "claude-ds-stream: no prompt. Use -p \"<prompt>\" or pipe via stdin." >&2
    exit 1
  fi
fi

# Coerce non-integer timeout values to 0 (off) so `[ "$X" -gt 0 ]` can't crash under set -e.
case "$MAX_RUNTIME"  in ''|*[!0-9]*) MAX_RUNTIME=0;;  esac
case "$IDLE_TIMEOUT" in ''|*[!0-9]*) IDLE_TIMEOUT=0;; esac

# ---- prepare the session directory ----
# Sessions root: cli-dispatch cache, with legacy claude-ds fallback (env wins).
SESSIONS_ROOT="$(resolve_sessions_root)"
RESUME=0
if [ -n "$RESUME_ID" ]; then
  SID="$RESUME_ID"
  RESUME=1
else
  SID="$(node -e 'process.stdout.write(require("crypto").randomUUID())' 2>/dev/null || true)"
  [ -z "$SID" ] && SID="$(uuidgen 2>/dev/null | tr 'A-Z' 'a-z' || true)"
  [ -z "$SID" ] && SID="$(date +%s)-$$-$RANDOM"
fi
SESSION_DIR="$SESSIONS_ROOT/$SID"
mkdir -p "$SESSION_DIR"
# Persist THIS wrapper's own pid ($$, NOT $CPID of the backgrounded claude process) as the
# worker-tree root. A dashboard takeover must kill the ENTIRE headless writer tree — the
# backgrounded claude process AND this wrapper's own post-wait finalize logic below — before
# spawning the interactive PTY, or the old writer clobbers status.json right after takeover
# starts. A stale worker.pid in a finished session is harmless: the dashboard only acts on it
# while status.json state=="running".
printf '%s' "$$" > "$SESSION_DIR/worker.pid" 2>/dev/null || true
printf '%s' "$PROMPT" > "$SESSION_DIR/prompt.txt" 2>/dev/null || true

BRANCH="$(git -C "$CWD" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
MODEL="${DS_MODEL:-deepseek-v4-pro}"

# --effort low|medium|high → thinking budget via MAX_THINKING_TOKENS. Best-effort:
# claude honors the env; whether DeepSeek's Anthropic-compatible API applies the
# thinking budget is up to the API (a no-op there degrades gracefully).
THINK=""
if [ -n "$EFFORT" ]; then
  EFFORT="$(printf '%s' "$EFFORT" | tr '[:upper:]' '[:lower:]')"
  case "$EFFORT" in
    low)    THINK=1024;;
    medium) THINK=8192;;
    high)   THINK=31999;;
    *) echo "claude-ds-stream: --effort must be low|medium|high (got \"$EFFORT\")." >&2; exit 2;;
  esac
fi

echo "claude-ds session: $SID" >&2
echo "  cwd:    $CWD" >&2
echo "  dir:    $SESSION_DIR" >&2
echo "  status: $SESSION_DIR/status.json" >&2
echo "  log:    $SESSION_DIR/progress.log" >&2

# ---- claude arguments (same core as octo-ai buildClaudeArgs) ----
CLAUDE_ARGS=(
  --print
  --output-format stream-json
  --include-partial-messages
  --verbose
  --permission-mode bypassPermissions
  # Don't inherit the user's global ~/.claude MCP servers (playwright code-exec,
  # whatsapp, gmail, jira, ...) into the delegated worker. With bypassPermissions the
  # worker could otherwise drive ALL of them. To add MCP servers deliberately, pass
  # --mcp-config <file> (PASS_ARGS) — strict honors that while ignoring the global set.
  --strict-mcp-config
  --add-dir "$CWD"
)
if [ "$RESUME" -eq 1 ]; then
  CLAUDE_ARGS+=(--resume "$SID")
else
  CLAUDE_ARGS+=(--session-id "$SID")
fi
# --read-only: restrict the worker to a read-only tool set. --tools is RESTRICTIVE
# (it REPLACES the built-in tool set), so Write/Edit/Bash are simply unavailable even
# under bypassPermissions. NB: --disallowed-tools does NOT work here — bypassPermissions
# skips the permission system that deny rules live in, so denied tools still run.
if [ "$READ_ONLY" -eq 1 ]; then
  # --strict-mcp-config (already in CLAUDE_ARGS) + an explicit empty --mcp-config
  # together give an unambiguous "zero MCP servers, project or global" guarantee
  # instead of relying on implicit absence-of-flag behavior.
  # NOTE: this does NOT close the hooks-based gap — hooks (PreToolUse/PostToolUse)
  # are a separate mechanism from tool/MCP config and can still execute arbitrary
  # local code on Read/Grep calls regardless of these flags. That is exactly why
  # the post-run read-only integrity guard (below) exists.
  EMPTY_MCP_CONFIG="$(mktemp -t ds-mcp-empty-XXXXXX.json)"
  printf '{"mcpServers":{}}' > "$EMPTY_MCP_CONFIG"
  CLAUDE_ARGS+=(--tools "Read,Grep,Glob" --mcp-config "$EMPTY_MCP_CONFIG")
fi
if [ "${#PASS_ARGS[@]}" -gt 0 ]; then
  CLAUDE_ARGS+=("${PASS_ARGS[@]}")
fi

# Optional safety net: a background watchdog kills the worker if it exceeds the overall
# runtime cap or stalls with no new output. Activity = transcript.jsonl mtime (the parser
# appends every event there). claude is backgrounded inside the subshell so we can record
# its PID; the subshell still cd's into $CWD and exits with claude's exit code.
PIDFILE="$SESSION_DIR/.claude.pid"
TIMEOUT_FILE="$SESSION_DIR/.timeout"
rm -f "$PIDFILE" "$TIMEOUT_FILE"

# Process helpers: mtime_of, kill_tree, proc_tree, kill_worker — defined in stream-utils.sh
# (sourced above).

watchdog() {
  local start now pid m
  start=$(date +%s)
  for _ in $(seq 1 80); do [ -s "$PIDFILE" ] && break; sleep 0.25; done
  pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  [ -z "$pid" ] && return 0
  while kill -0 "$pid" 2>/dev/null; do
    sleep 2
    now=$(date +%s)
    if [ "$MAX_RUNTIME" -gt 0 ] && [ "$((now - start))" -ge "$MAX_RUNTIME" ]; then
      printf 'runtime %ss' "$MAX_RUNTIME" > "$TIMEOUT_FILE"
      kill_worker "$pid"; return 0
    fi
    if [ "$IDLE_TIMEOUT" -gt 0 ]; then
      m="$(mtime_of "$SESSION_DIR/transcript.jsonl")"; m="${m:-$start}"
      if [ "$((now - m))" -ge "$IDLE_TIMEOUT" ]; then
        printf 'idle %ss' "$IDLE_TIMEOUT" > "$TIMEOUT_FILE"
        kill_worker "$pid"; return 0
      fi
    fi
  done
}

# Safety net: kill the worker and watchdog on any exit (normal, signal, or error).
cleanup() {
  local _pid
  [ -n "${WATCHDOG_PID:-}" ] && kill_tree "$WATCHDOG_PID" -TERM 2>/dev/null || true
  _pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  [ -n "$_pid" ] && kill_worker "$_pid" 2>/dev/null || true
  rm -f "${PARSER_DONE:-}" 2>/dev/null || true
  [ -n "${EMPTY_MCP_CONFIG:-}" ] && rm -f "$EMPTY_MCP_CONFIG" 2>/dev/null || true
}
trap cleanup EXIT

# Interrupt handling: kill the claude worker (PIDFILE) then wait (bounded) for the
# parser to drain stdin EOF and finalize status.json — the parser is the right-hand
# side of a literal pipe (`| node "$PARSER"`), so it sees EOF when claude dies, runs
# its finalize, and touches PARSER_DONE only AFTER writing status.json. Reconciling
# only once PARSER_DONE exists guarantees our "error" record is written LAST and not
# clobbered by a still-draining parser finalize (same ordering the normal post-pipe
# block relies on).
handle_interrupt() {
  local sig="$1" rc="$2"
  trap - INT TERM
  echo "claude-ds-stream: interrupted ($sig)." >&2
  local _pid
  _pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  [ -n "$_pid" ] && kill_tree "$_pid" -TERM 2>/dev/null || true
  for _ in $(seq 1 30); do [ -e "${PARSER_DONE:-/nonexistent}" ] && break; sleep 0.1; done
  reconcile_session_error "$SESSION_DIR" "interrupted: $sig" "$rc"
  cleanup
  exit "$rc"
}
trap 'handle_interrupt INT 130' INT
trap 'handle_interrupt TERM 143' TERM

WATCHDOG_PID=""
if [ "$MAX_RUNTIME" -gt 0 ] || [ "$IDLE_TIMEOUT" -gt 0 ]; then
  echo "  guard:  max-runtime=${MAX_RUNTIME}s idle-timeout=${IDLE_TIMEOUT}s" >&2
  watchdog & WATCHDOG_PID=$!
fi

# claude runs cd'd into $CWD (working dir, not just --add-dir), prompt via stdin (process
# substitution so variadic flags can't swallow it AND claude can be backgrounded with a
# captured PID for the watchdog). Subshell exits with claude's exit code.
PARSER_DONE="$(mktemp -u -t ds-pdone-XXXXXX)"
set +e
( cd "$CWD" || exit 127
  env \
    ANTHROPIC_BASE_URL="https://api.deepseek.com/anthropic" \
    ANTHROPIC_AUTH_TOKEN="$DEEPSEEK_API_KEY" \
    ANTHROPIC_MODEL="${DS_MODEL:-deepseek-v4-pro}" \
    ANTHROPIC_DEFAULT_OPUS_MODEL="${DS_MODEL:-deepseek-v4-pro}" \
    ANTHROPIC_DEFAULT_SONNET_MODEL="${DS_MODEL:-deepseek-v4-pro}" \
    ANTHROPIC_DEFAULT_HAIKU_MODEL="${DS_FLASH_MODEL:-deepseek-v4-flash}" \
    CLAUDE_CODE_SUBAGENT_MODEL="${DS_FLASH_MODEL:-deepseek-v4-flash}" \
    ${THINK:+MAX_THINKING_TOKENS="$THINK"} \
    claude "${CLAUDE_ARGS[@]}" < <(printf '%s' "$PROMPT") &
  CPID=$!
  echo "$CPID" > "$PIDFILE"
  wait "$CPID" ) \
  | { CLAUDE_DS_SESSION_DIR="$SESSION_DIR" \
      CLAUDE_DS_PROMPT_PREVIEW="$(printf '%.120s' "$PROMPT")" \
      CLAUDE_DS_CWD="$CWD" \
      CLAUDE_DS_BRANCH="$BRANCH" \
      CLAUDE_DS_MODEL="$MODEL${THINK:+ (${EFFORT})}" \
      CLAUDE_DS_RESUME="$RESUME" \
        node "$PARSER"; touch "$PARSER_DONE"; }
# PIPESTATUS: [0]=claude subshell (via wait), [1]=node parser. We want claude's exit.
CLAUDE_RC=${PIPESTATUS[0]}
set -e

# Tear down the watchdog and any sleep child it left behind (it usually self-exits when
# claude finishes, but may be mid-sleep when we get here).
[ -n "$WATCHDOG_PID" ] && kill_tree "$WATCHDOG_PID" -TERM

# ---- human-controlled guard (defense-in-depth) ----
# If a human already took over this session, the dashboard tree-killed the WHOLE worker
# (via worker.pid, see above) and spawned an interactive PTY that now owns status.json,
# writing state:"human-controlled". That kill normally reaps this wrapper before it ever
# gets here — but if it raced or somehow missed us, this guard stops the reconcile logic
# below from clobbering the dashboard's record. Exit 0 so the caller sees a clean exit;
# the EXIT trap (cleanup) still runs.
TAKEOVER_STATE="$(json_field "$SESSION_DIR/status.json" state || true)"
if [ "$TAKEOVER_STATE" = "human-controlled" ]; then
  echo "claude-ds-stream: session taken over by a human — leaving record to the dashboard." >&2
  exit 0
fi

# ---- post-run read-only integrity guard (defense-in-depth against hooks bypass) ----
# Hooks (PreToolUse/PostToolUse) fire on Read/Grep calls and can execute arbitrary
# local code regardless of --tools/--mcp-config flags. This guard detects any writes
# that leaked through despite --read-only — it does NOT revert them, only reports.
READONLY_VIOLATION=""
if [ "$READ_ONLY" -eq 1 ]; then
  RO_STATUS="$(git -C "$CWD" status --short 2>/dev/null || true)"
  if [ -n "$RO_STATUS" ]; then
    RO_COUNT="$(printf '%s\n' "$RO_STATUS" | wc -l | tr -d ' ')"
    echo ">>> READ-ONLY VIOLATION: $RO_COUNT file(s) modified in $CWD despite --read-only" >&2
    echo "$RO_STATUS" >&2
    READONLY_VIOLATION="read-only violation: ${RO_COUNT} file(s) modified despite --read-only"
  fi
fi

# Reconcile session state the parser can't infer from stdin EOF alone: a timeout kill,
# a claude crash (nonzero exit / bad cwd / no output), or a read-only violation should
# read "error", not "done". Read-only violation takes priority — it means the safety
# guarantee itself broke, which is more important than claude's own exit code.
ERR=""
if [ -n "$READONLY_VIOLATION" ]; then
  ERR="$READONLY_VIOLATION"
elif [ -f "$TIMEOUT_FILE" ]; then
  ERR="timeout: $(cat "$TIMEOUT_FILE" 2>/dev/null)"
elif [ "${CLAUDE_RC:-0}" -ne 0 ]; then
  ERR="claude exited $CLAUDE_RC"
fi
if [ -n "$ERR" ]; then
  reconcile_session_error "$SESSION_DIR" "$ERR" "${CLAUDE_RC:-0}"
fi

rm -f "$PIDFILE" "$TIMEOUT_FILE"
exit "$CLAUDE_RC"
