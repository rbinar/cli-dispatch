#!/usr/bin/env bash
# ag-stream — the session-tracked Antigravity (agy / Gemini) worker, mirroring claude-ds-stream.
#
# agy is a DIFFERENT binary from claude (own auth/config/output). The "swap the env var"
# trick used for DeepSeek does NOT apply. Two facts shape this wrapper (verified, agy v1.0.10):
#   1. No --output-format json  → there is no structured stdout stream to parse.
#   2. Non-TTY silent-drop bug   → piping agy's stdout can silently drop output (exit 0).
# So we run agy under a pseudo-TTY (`script`) and TAIL its on-disk JSONL transcript for
# live progress + the final answer, via ag-transcript-parse.mjs.
#
# Usage:
#   ag-stream [--cwd <dir>] [--resume <conv-id>] [--read-only] [--model <m>] \
#             [--effort low|medium|high] [--max-runtime <s>] [--idle-timeout <s>] \
#             [--verify-cmd <cmd>] -p "<prompt>" [extra agy flags]
#   echo "<prompt>" | ag-stream [--cwd <dir>]
#
# Session directory: ${XDG_CACHE_HOME:-$HOME/.cache}/cli-dispatch/sessions/<conv-id>/ (legacy: claude-ds)
# (same layout as claude-ds, so /cli-dispatch:ds-watch / ds-sessions work for both backends.)
#
# Auth: Google keyring (run `agy` once interactively to sign in) OR a key in the config
# (GEMINI_API_KEY / ANTIGRAVITY_API_KEY). Optional AG_MODEL in the config sets --model.
#
# On a fresh (non-resume) run, a cheap auth preflight runs before the real agy call — if it
# detects the session is logged out, this exits 3 (a distinct auth-failure code; see
# classifyAuthFailure/writeAuthErrorSession in parse-utils.mjs) instead of producing an empty
# transcript with a generic error (issue #73).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$SCRIPT_DIR/stream-utils.sh"

command -v agy >/dev/null 2>&1 || {
  echo "ag-stream: 'agy' (Antigravity CLI) not found in PATH." >&2
  echo "  install: curl -fsSL https://antigravity.google/cli/install.sh | bash" >&2
  exit 1
}
command -v script >/dev/null 2>&1 || { echo "ag-stream: 'script' (pseudo-tty) not found in PATH." >&2; exit 1; }
command -v node   >/dev/null 2>&1 || { echo "ag-stream: 'node' not found (required for the transcript parser)." >&2; exit 1; }

# Optional config (shared across backends). cli-dispatch dir, legacy claude-ds fallback (env wins).
source_config

# Forward the host's gh auth (macOS keyring) into the worker env (issue #56).
maybe_export_gh_token

# Resolve the parser: env > installed location > script dir.
PARSER="${AG_PARSER:-}"
if [ -z "$PARSER" ]; then
  for cand in "$HOME/.local/share/cli-dispatch/ag-transcript-parse.mjs" "$HOME/.local/share/claude-ds/ag-transcript-parse.mjs" "$SCRIPT_DIR/ag-transcript-parse.mjs"; do
    [ -f "$cand" ] && { PARSER="$cand"; break; }
  done
fi
[ -n "$PARSER" ] && [ -f "$PARSER" ] || { echo "ag-stream: ag-transcript-parse.mjs not found (set AG_PARSER)." >&2; exit 1; }

# Resolve parse-utils.mjs the SAME way as the parser (installed to LIBEXEC, not next to this
# wrapper in $BIN). The E7 conv-id ownership matching (select_owned_conv) imports it.
PARSE_UTILS=""
for cand in "$HOME/.local/share/cli-dispatch/parse-utils.mjs" "$HOME/.local/share/claude-ds/parse-utils.mjs" "$SCRIPT_DIR/parse-utils.mjs"; do
  [ -f "$cand" ] && { PARSE_UTILS="$cand"; break; }
done

# ---- parse arguments ----
CWD="$(pwd)"
RESUME_ID=""
PROMPT=""
HAVE_PROMPT=0
READ_ONLY=0
MODEL="${AG_MODEL:-}"
EFFORT="${AG_EFFORT:-}"
MAX_RUNTIME="${AG_MAX_RUNTIME:-0}"
IDLE_TIMEOUT="${AG_IDLE_TIMEOUT:-0}"
VERIFY_CMD="${CLI_DISPATCH_VERIFY_CMD:-}"
PASS_ARGS=()
need_val() { [ "$2" -ge 2 ] || { echo "ag-stream: $1 requires a value." >&2; exit 1; }; }
while [ "$#" -gt 0 ]; do
  case "$1" in
    --cwd)            need_val --cwd "$#";    CWD="$2"; shift 2;;
    --cwd=*)          CWD="${1#*=}"; shift;;
    --resume)         need_val --resume "$#"; RESUME_ID="$2"; shift 2;;
    --resume=*)       RESUME_ID="${1#*=}"; shift;;
    --model)          need_val --model "$#";  MODEL="$2"; shift 2;;
    --model=*)        MODEL="${1#*=}"; shift;;
    --effort)         need_val --effort "$#"; EFFORT="$2"; shift 2;;
    --effort=*)       EFFORT="${1#*=}"; shift;;
    -p|--prompt)      need_val "$1" "$#";     PROMPT="$2"; HAVE_PROMPT=1; shift 2;;
    -p=*)             PROMPT="${1#*=}"; HAVE_PROMPT=1; shift;;
    --prompt=*)       PROMPT="${1#*=}"; HAVE_PROMPT=1; shift;;
    --read-only)      READ_ONLY=1; shift;;
    --max-runtime)    need_val --max-runtime "$#";  MAX_RUNTIME="$2"; shift 2;;
    --max-runtime=*)  MAX_RUNTIME="${1#*=}"; shift;;
    --idle-timeout)   need_val --idle-timeout "$#"; IDLE_TIMEOUT="$2"; shift 2;;
    --idle-timeout=*) IDLE_TIMEOUT="${1#*=}"; shift;;
    --verify-cmd)     need_val --verify-cmd "$#"; VERIFY_CMD="$2"; shift 2;;
    --verify-cmd=*)   VERIFY_CMD="${1#*=}"; shift;;
    *)                PASS_ARGS+=("$1"); shift;;
  esac
done

if [ "$HAVE_PROMPT" -eq 0 ]; then
  if [ ! -t 0 ]; then PROMPT="$(cat)"; else
    echo "ag-stream: no prompt. Use -p \"<prompt>\" or pipe via stdin." >&2; exit 1
  fi
fi
# Reject an empty/whitespace-only prompt: agy with `-p ""` produces no new conversation,
# which would push discovery onto the fallback and risk attaching to a STALE conv-id.
if [ -z "${PROMPT//[[:space:]]/}" ]; then
  echo "ag-stream: empty prompt — nothing to delegate." >&2; exit 1
fi
case "$MAX_RUNTIME"  in ''|*[!0-9]*) MAX_RUNTIME=0;;  esac
case "$IDLE_TIMEOUT" in ''|*[!0-9]*) IDLE_TIMEOUT=0;; esac

# Export an auth key if present; otherwise rely on the Google keyring (agy sign-in).
[ -n "${GEMINI_API_KEY:-}" ]      && export GEMINI_API_KEY
[ -n "${ANTIGRAVITY_API_KEY:-}" ] && export ANTIGRAVITY_API_KEY

# Make CWD absolute (last_conversations.json keys are absolute paths).
CWD="$(cd "$CWD" 2>/dev/null && pwd)" || { echo "ag-stream: bad --cwd" >&2; exit 1; }

# Snapshot dirty/untracked paths in $CWD BEFORE the worker runs, so write_diff_artifacts
# (called after agy finishes, below) can exclude pre-existing dirt from the reported
# changed-files list — see snapshot_dirty_paths in stream-utils.sh.
PREEXISTING_DIRTY="$(snapshot_dirty_paths "$CWD")"

AG_HOME="$HOME/.gemini/antigravity-cli"
LC="$AG_HOME/cache/last_conversations.json"
BRAIN="$AG_HOME/brain"

model_key() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cd '0-9a-z'
}

model_listed() {
  local model="$1"
  local want
  local models
  local line

  want="$(model_key "$model")"
  if ! models="$(agy models 2>/dev/null)"; then
    return 0
  fi
  [ -n "$models" ] || return 0

  while IFS= read -r line; do
    [ -n "$line" ] || continue
    if [ "$(model_key "$line")" = "$want" ]; then
      return 0
    fi
  done <<< "$models"
  return 1
}

apply_effort_suffix() {
  local name="$1"
  local suffix="$2"
  local base
  local lower
  local suffix_lower

  if [[ "$name" != *" "* ]]; then
    base="$name"
    # tr, not bash 4's lowercase parameter expansion — macOS still ships /bin/bash 3.2.
    lower="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')"
    case "$lower" in
      *-low|*-medium|*-high|*-thinking) base="${base%-*}";;
    esac
    suffix_lower="$(printf '%s' "$suffix" | tr '[:upper:]' '[:lower:]')"
    printf '%s-%s\n' "$base" "$suffix_lower"
  else
    if [[ "$name" =~ ^(.*)\([A-Za-z]+\)$ ]]; then
      base="${BASH_REMATCH[1]}"
      while [[ "$base" == *[[:space:]] ]]; do
        base="${base%?}"
      done
    else
      base="$name"
    fi
    printf '%s (%s)\n' "$base" "$suffix"
  fi
}

pick_model_for_effort() {
  local suffix="$1"
  local suffix_lower
  local models
  local line
  local lower

  suffix_lower="$(printf '%s' "$suffix" | tr '[:upper:]' '[:lower:]')"
  if ! models="$(agy models 2>/dev/null)"; then
    printf 'Gemini 3.5 Flash (%s)\n' "$suffix"
    return 0
  fi
  [ -n "$models" ] || { printf 'Gemini 3.5 Flash (%s)\n' "$suffix"; return 0; }

  while IFS= read -r line; do
    lower="$(printf '%s' "$line" | tr '[:upper:]' '[:lower:]')"
    if [[ "$lower" == *-"$suffix_lower" || "$lower" == *"($suffix_lower)" ]]; then
      printf '%s\n' "$line"
      return 0
    fi
  done <<< "$models"

  printf 'Gemini 3.5 Flash (%s)\n' "$suffix"
}

# --effort low|medium|high: agy accepts both display names and slugs, but
# `agy models` prints slugs as of 1.1.8. With --model, preserve the caller's
# format while replacing any existing effort suffix; without it, pick the first
# listed model at that effort (falling back to the known default family).
if [ -n "$EFFORT" ]; then
  case "$(printf '%s' "$EFFORT" | tr '[:upper:]' '[:lower:]')" in
    low) SUF="Low";; medium) SUF="Medium";; high) SUF="High";;
    *) echo "ag-stream: --effort must be low|medium|high (got \"$EFFORT\")." >&2; exit 2;;
  esac
  if [ -n "$MODEL" ]; then
    MODEL="$(apply_effort_suffix "$MODEL" "$SUF")"
  else
    MODEL="$(pick_model_for_effort "$SUF")"
  fi
fi

# Validate --model against `agy models`. agy SILENTLY falls back to its default for an
# unknown model (no error), so a typo would quietly run the wrong model — warn instead.
# agy accepts either a display name or a slug; `agy models` prints slugs as of 1.1.8.
# The warning fires only when the model matches nothing in either format.
if [ -n "$MODEL" ]; then
  if ! model_listed "$MODEL"; then
    echo "ag-stream: warning — model \"$MODEL\" is not listed by \`agy models\`; agy will" >&2
    echo "  silently use its default. Run \`agy models\` for listed slugs; display names with" >&2
    echo "  reasoning suffixes are also accepted by agy." >&2
  fi
fi

# ---- build the agy command ----
# --add-dir registers $CWD as the active workspace. WITHOUT it, agy may decide it has
# "no active workspace" and scaffold into its own ~/.gemini scratch dir instead of $CWD,
# which would defeat worktree isolation. (cd-ing the process into $CWD is not enough.)
AGY_ARGS=(-p "$PROMPT" --add-dir "$CWD")
# Runtime cap via agy's OWN --print-timeout. This is the only RELIABLE bound for the agy
# backend: agy spawns detached worker process(es) and runs under a pty, so an external
# process-tree kill (our watchdog) can't be relied on to stop the work — but agy's internal
# print-timeout does stop it. Trade-off: when agy self-terminates at the cap it exits cleanly
# (exit 0, partial output), so the session reports `done` (with partial output), NOT `error`.
# Our watchdog below is only a BEST-EFFORT backstop for a fully-hung agy. (See docs.)
PT="${MAX_RUNTIME:-0}"; [ "$PT" -gt 0 ] || PT=600
AGY_ARGS+=(--print-timeout "${PT}s")
# NOTE: agy has NO verified write-deny flag. `--sandbox` restricts the *terminal* but NOT
# the internal write_to_file tool — tested: agy under --sandbox still wrote a file. So we do
# NOT offer a read-only guarantee here (unlike the DeepSeek backend's hard --tools deny).
# Rejecting --read-only is safer than shipping a control that silently fails to protect.
if [ "$READ_ONLY" -eq 1 ]; then
  echo "ag-stream: --read-only is NOT supported on the Antigravity backend." >&2
  echo "  agy has no tool-level write-deny (--sandbox restricts the terminal, not file writes)." >&2
  echo "  For a no-writes guarantee, isolate the run in a throwaway/worktree --cwd and review the diff." >&2
  exit 2
fi
AGY_ARGS+=(--dangerously-skip-permissions)
[ -n "$MODEL" ] && AGY_ARGS+=(--model "$MODEL")
RESUME=0
if [ -n "$RESUME_ID" ]; then
  RESUME=1
  AGY_ARGS+=(--conversation "$RESUME_ID")
fi
[ "${#PASS_ARGS[@]}" -gt 0 ] && AGY_ARGS+=("${PASS_ARGS[@]}")

# ---- run agy under a pseudo-TTY (OS-specific `script` syntax) ----
PIDFILE="$(mktemp -t ag-pid-XXXXXX)"; rm -f "$PIDFILE"
run_agy_bg() { # backgrounds agy under a pty, writes its PID to $PIDFILE
  case "$(uname -s)" in
    Darwin|*BSD)
      ( cd "$CWD" && exec script -q /dev/null agy "${AGY_ARGS[@]}" ) >/dev/null 2>&1 &
      ;;
    *) # Linux/util-linux: command must be a single -c string; -e propagates exit code.
      local q="" a; for a in agy "${AGY_ARGS[@]}"; do q+="$(printf '%q ' "$a")"; done
      ( cd "$CWD" && exec script -qec "$q" /dev/null ) >/dev/null 2>&1 &
      ;;
  esac
  echo $! > "$PIDFILE"
}

# ---- auth preflight check ----
if [ "$RESUME" -eq 0 ]; then
  PREFLIGHT_OUT="$(mktemp -t ag-preflight-XXXXXX)"
  PREFLIGHT_PID=""

  # Run a minimal, cheap, DIRECT agy call to test auth.
  ( cd "$CWD" && exec agy -p "ping" --print-timeout 5s --dangerously-skip-permissions ) > "$PREFLIGHT_OUT" 2>&1 &
  PREFLIGHT_PID=$!

  # Bound total wall-clock time (hard cap of ~35 seconds).
  CAP=35
  PREFLIGHT_RC=0
  for i in $(seq 1 $((CAP * 4))); do
    if ! kill -0 "$PREFLIGHT_PID" 2>/dev/null; then
      break
    fi
    sleep 0.25
  done

  if kill -0 "$PREFLIGHT_PID" 2>/dev/null; then
    # Timed out — kill the process tree of the preflight run.
    kill_worker "$PREFLIGHT_PID"
    wait "$PREFLIGHT_PID" 2>/dev/null || true
    PREFLIGHT_RC=1
  else
    set +e
    wait "$PREFLIGHT_PID"
    PREFLIGHT_RC=$?
    set -e
  fi

  # Classify the results of the preflight auth check.
  IS_AUTH_FAILURE="$(node -e '
    Promise.all([
      import("file://" + process.argv[1]),
      import("node:fs")
    ]).then(([m, fs]) => {
      const output = fs.readFileSync(process.argv[3], "utf8");
      const res = m.classifyAuthFailure(Number(process.argv[2]), output);
      process.stdout.write(res.isAuthFailure ? "true" : "false");
    }).catch(err => {
      process.stderr.write(err.stack + "\n");
      process.stdout.write("false");
    });
  ' "$PARSE_UTILS" "$PREFLIGHT_RC" "$PREFLIGHT_OUT" 2>/dev/null || echo "false")"

  # Delete temp file.
  rm -f "$PREFLIGHT_OUT"

  if [ "$IS_AUTH_FAILURE" = "true" ]; then
    SESSIONS_ROOT="$(resolve_sessions_root)"
    CID="auth-fail-$(date +%Y%m%d%H%M%S)-$((1000 + RANDOM % 9000))"
    SESSION_DIR="$SESSIONS_ROOT/$CID"
    
    BRANCH="$(git -C "$CWD" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    
    # Write status.json and meta.json using our node helper.
    node -e '
      import("file://" + process.argv[1]).then(m => {
        m.writeAuthErrorSession(
          process.argv[2],
          process.argv[3],
          Number(process.argv[4]),
          process.argv[5],
          process.argv[6],
          process.argv[7]
        );
      });
    ' "$PARSE_UTILS" "$SESSION_DIR" \
      "Antigravity oturumu yok — kullanıcı 'agy' ile interaktif login olmalı veya GEMINI_API_KEY set edilmeli" \
      "3" "$CWD" "$BRANCH" "$MODEL"

    # Write prompt.txt to the session dir for completeness.
    printf '%s' "$PROMPT" > "$SESSION_DIR/prompt.txt" 2>/dev/null || true

    # Print error to stderr and exit with distinct exit code 3.
    echo "ag-stream: Antigravity oturumu yok — kullanıcı 'agy' ile interaktif login olmalı veya GEMINI_API_KEY set edilmeli" >&2
    echo "  dir:    $SESSION_DIR" >&2
    exit 3
  fi
fi

# Snapshot pre-run state for conv-id discovery (E7): the FULL set of pre-existing
# conversation-ids — last_conversations.json values UNION existing brain/ subdirs — captured
# BEFORE launch. Discovery then only ever considers conversations CREATED by this run.
# (Includes the preflight ping's own conversation, created just above.) This is the anchor of
# the same-cwd hijack fix: last_conversations.json is keyed by cwd and keeps only the LAST
# writer, so a cwd-keyed lookup — or "newest brain dir" — can hand this run a PARALLEL
# same-cwd run's conv-id. Snapshot + per-candidate ownership matching (see discover_cid /
# select_owned_conv) attaches strictly to the conversation whose first user message is OURS.
PRE_IDS_FILE="$(mktemp -t ag-preids-XXXXXX)"
E7_LC="$LC" E7_BRAIN="$BRAIN" node --input-type=module -e '
  import { readFileSync, readdirSync } from "node:fs"
  const out = new Set()
  try { const m = JSON.parse(readFileSync(process.env.E7_LC, "utf8")); for (const v of Object.values(m)) if (typeof v === "string" && v) out.add(v) } catch {}
  try { for (const d of readdirSync(process.env.E7_BRAIN)) out.add(d) } catch {}
  process.stdout.write([...out].join("\n"))
' > "$PRE_IDS_FILE" 2>/dev/null || true

# Process helpers: mtime_of, kill_tree, proc_tree, kill_worker — defined in stream-utils.sh
# (sourced above). Defined BEFORE launch so the discovery-failure path can kill a hung agy.

echo "ag-stream → Antigravity (agy) worker" >&2
echo "  cwd:    $CWD" >&2
[ "$RESUME" -eq 1 ] && echo "  resume: $RESUME_ID" >&2

run_agy_bg
AGY_PID="$(cat "$PIDFILE" 2>/dev/null || true)"
[ -n "$AGY_PID" ] || { echo "ag-stream: failed to launch agy." >&2; rm -f "$PIDFILE"; exit 1; }

# ---- discover the conversation-id this run created (or use the resume id) ----
# select_owned_conv: enumerate conversation-ids that did NOT exist in the pre-launch snapshot
# (last_conversations.json values ∪ brain/ subdirs, minus PRE_IDS_FILE), then return the one
# whose FIRST user message is OUR prompt — never a parallel same-cwd run's. Prints the owned
# conv-id or nothing (keep polling). The prompt is passed via env (may contain anything).
select_owned_conv() {
  E7_PROMPT="$PROMPT" E7_LC="$LC" E7_BRAIN="$BRAIN" E7_PRE="$PRE_IDS_FILE" E7_PU="$PARSE_UTILS" \
  node --input-type=module -e '
    import { readFileSync, readdirSync } from "node:fs"
    import path from "node:path"
    const { selectOwnedConversation } = await import("file://" + process.env.E7_PU)
    const brain = process.env.E7_BRAIN
    const pre = new Set()
    try { for (const l of readFileSync(process.env.E7_PRE, "utf8").split("\n")) { const t = l.trim(); if (t) pre.add(t) } } catch {}
    const ids = new Set()
    try { const m = JSON.parse(readFileSync(process.env.E7_LC, "utf8")); for (const v of Object.values(m)) if (typeof v === "string" && v) ids.add(v) } catch {}
    try { for (const d of readdirSync(brain)) ids.add(d) } catch {}
    const candidates = []
    for (const cid of ids) {
      if (pre.has(cid)) continue
      let text = null
      try { text = readFileSync(path.join(brain, cid, ".system_generated", "logs", "transcript_full.jsonl"), "utf8") } catch {}
      candidates.push({ cid, transcriptText: text })
    }
    const owned = selectOwnedConversation(process.env.E7_PROMPT || "", candidates)
    if (owned) process.stdout.write(owned)
  ' 2>/dev/null
}
discover_cid() {
  if [ "$RESUME" -eq 1 ]; then printf '%s' "$RESUME_ID"; return 0; fi
  local cid="" i
  for i in $(seq 1 120); do   # up to ~30s
    cid="$(select_owned_conv)"
    [ -n "$cid" ] && { printf '%s' "$cid"; return 0; }
    if ! kill -0 "$AGY_PID" 2>/dev/null; then
      # agy already exited — give the transcript one last chance to flush, then stop.
      cid="$(select_owned_conv)"
      [ -n "$cid" ] && { printf '%s' "$cid"; return 0; }
      break
    fi
    sleep 0.25
  done
  return 1
}
CID="$(discover_cid || true)"
if [ -z "$CID" ]; then
  # E7: discovery failed — either agy created no conversation, OR the only NEW conversation(s)
  # belonged to a PARALLEL same-cwd run (first user message did not match OUR prompt). Writing
  # an explicit error session is deliberately safer than silently attaching to a sibling's
  # conversation (which would mislabel meta.json with our prompt while streaming the other
  # task, leaving the real work untracked).
  echo "ag-stream: could not identify the agy conversation this run created" >&2
  echo "  (no NEW conversation matched this run's prompt — possible parallel same-cwd race)." >&2
  SESSIONS_ROOT="$(resolve_sessions_root)"
  CID_FAIL="discover-fail-$(date +%Y%m%d%H%M%S)-$((1000 + RANDOM % 9000))"
  FAIL_DIR="$SESSIONS_ROOT/$CID_FAIL"
  FAIL_BRANCH="$(git -C "$CWD" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  mkdir -p "$FAIL_DIR" 2>/dev/null || true
  printf '%s' "$PROMPT" > "$FAIL_DIR/prompt.txt" 2>/dev/null || true
  E7_DF_DIR="$FAIL_DIR" E7_DF_CWD="$CWD" E7_DF_BRANCH="$FAIL_BRANCH" E7_DF_MODEL="$MODEL" \
  E7_DF_PROMPT="$(printf '%.120s' "$PROMPT")" node --input-type=module -e '
    import { writeFileSync } from "node:fs"
    import path from "node:path"
    const dir = process.env.E7_DF_DIR, now = new Date().toISOString(), sId = path.basename(dir)
    const err = "conv-id discovery failed: no new conversation matched this run'\''s prompt (possible parallel same-cwd race)"
    const status = { sessionId: sId, backend: "antigravity", convId: "", state: "error", error: err, errorKind: "discovery", lastTool: null, toolCounts: {}, events: 0, startedAt: now, lastActivityAt: now, finalResultPreview: "", usage: null }
    const meta = { sessionId: sId, backend: "antigravity", convId: "", promptPreview: process.env.E7_DF_PROMPT || "", cwd: process.env.E7_DF_CWD || "", branch: process.env.E7_DF_BRANCH || "", model: process.env.E7_DF_MODEL || "", startedAt: now, endedAt: now, exitCode: 1, state: "error", error: err, errorKind: "discovery" }
    try { writeFileSync(path.join(dir, "status.json"), JSON.stringify(status, null, 2) + "\n") } catch {}
    try { writeFileSync(path.join(dir, "meta.json"), JSON.stringify(meta, null, 2) + "\n") } catch {}
  ' 2>/dev/null || true
  echo "  dir:    $FAIL_DIR" >&2
  # Don't `wait` (a startup-hung agy never exits → infinite block). We own the process,
  # so kill the subtree, reap it, and bail.
  kill_worker "$AGY_PID"
  wait "$AGY_PID" 2>/dev/null || true
  rm -f "$PIDFILE" "${PRE_IDS_FILE:-}"
  exit 1
fi

TRANSCRIPT="$BRAIN/$CID/.system_generated/logs/transcript_full.jsonl"
SESSIONS_ROOT="$(resolve_sessions_root)"
SESSION_DIR="$SESSIONS_ROOT/$CID"
mkdir -p "$SESSION_DIR"
# Persist THIS wrapper's own pid ($$) as the worker-tree root. A dashboard takeover needs to
# kill the whole headless writer tree (the script-wrapped agy child + the background parser
# below) before spawning the interactive PTY, or the old writers clobber status.json right
# after takeover starts. CAVEAT: agy is known to sometimes ignore termination signals and
# reparent itself, so a tree-kill rooted here is BEST-EFFORT for the actual agy binary
# specifically — an accepted, dashboard-side limitation, not something fixed in this wrapper.
# A stale worker.pid in a finished session is harmless: the dashboard only acts on it while
# status.json state=="running".
printf '%s' "$$" > "$SESSION_DIR/worker.pid" 2>/dev/null || true
printf '%s' "$PROMPT" > "$SESSION_DIR/prompt.txt" 2>/dev/null || true
DONEFILE="$SESSION_DIR/.agy.done"; rm -f "$DONEFILE"
BRANCH="$(git -C "$CWD" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"

echo "  conv:   $CID" >&2
echo "  dir:    $SESSION_DIR" >&2
echo "  status: $SESSION_DIR/status.json" >&2

# ---- cleanup + signal handling (mirrors cp-stream) ----
# On ANY exit path reap the watchdog, the tail parser, and the agy worker so nothing leaks.
# CRITICAL (issue: ag-stream had NO trap): on an EXTERNAL SIGINT/SIGTERM — a dashboard
# takeover-kill of this headless worker, or a user Ctrl-C — the tail parser
# (ag-transcript-parse.mjs) would otherwise poll for the .agy.done sentinel FOREVER (its
# tick() only finalizes once AG_DONEFILE exists), leaving status.json stuck at
# state:"running". So handle_interrupt (a) WRITES .agy.done with the real signal exit code so
# the parser stops polling and finalizes as "error" (finalize(): done != "0"/"" → error), and
# (b) force-reconciles status.json/meta.json to "error" as a backstop in case the parser was
# already killed. Takeover-safety: killWorkerTree TERMs this tree and WAITS for it to die
# BEFORE the takeover PTY writes state:"human-controlled", so this error-write lands first and
# is then overwritten by the PTY — it cannot clobber a human-controlled record.
cleanup() {
  [ -n "${WATCHDOG_PID:-}" ] && kill_tree "$WATCHDOG_PID" -TERM 2>/dev/null || true
  [ -n "${PARSER_PID:-}" ] && kill_tree "$PARSER_PID" -TERM 2>/dev/null || true
  [ -n "${AGY_PID:-}" ] && kill -TERM "$AGY_PID" 2>/dev/null || true
  rm -f "${PIDFILE:-}" "${PRE_IDS_FILE:-}" 2>/dev/null || true
}
trap cleanup EXIT

handle_interrupt() {
  local sig="$1" rc="$2"
  trap - INT TERM
  echo "ag-stream: interrupted ($sig)." >&2
  # Unblock the tail parser: write the sentinel it polls for, with the real exit code so it
  # finalizes the record as "error" rather than hanging on state:"running".
  [ -n "${DONEFILE:-}" ] && printf '%s' "$rc" > "$DONEFILE" 2>/dev/null || true
  # Backstop: force the record to error even if the parser is already gone / mid-poll.
  [ -n "${SESSION_DIR:-}" ] && reconcile_session_error "$SESSION_DIR" "interrupted: $sig" "$rc"
  cleanup
  exit "$rc"
}
trap 'handle_interrupt INT 130' INT
trap 'handle_interrupt TERM 143' TERM

# ---- watchdog: BEST-EFFORT backstop (runtime cap + idle on transcript mtime) ----
# IMPORTANT: unlike the DeepSeek backend (where this watchdog hard-kills the worker), agy
# spawns detached worker process(es) and runs under a pty, so an external tree-kill is NOT a
# reliable stop — verified: SIGKILL on the whole tracked tree left agy working. The RELIABLE
# runtime bound is agy's own --print-timeout (set from --max-runtime above). This watchdog
# only backstops a fully-idle/hung agy whose pty is interruptible. (kill_worker / mtime_of
# are defined above, before launch.)
TIMEOUT_REASON=""
watchdog() {
  local start now m
  start=$(date +%s)
  while kill -0 "$AGY_PID" 2>/dev/null; do
    sleep 2
    now=$(date +%s)
    if [ "$MAX_RUNTIME" -gt 0 ] && [ "$((now - start))" -ge "$MAX_RUNTIME" ]; then
      echo "runtime ${MAX_RUNTIME}s" > "$SESSION_DIR/.timeout"
      kill_worker "$AGY_PID"; return 0
    fi
    if [ "$IDLE_TIMEOUT" -gt 0 ] && [ -f "$TRANSCRIPT" ]; then
      m="$(mtime_of "$TRANSCRIPT")"; m="${m:-$start}"
      if [ "$((now - m))" -ge "$IDLE_TIMEOUT" ]; then
        echo "idle ${IDLE_TIMEOUT}s" > "$SESSION_DIR/.timeout"
        kill_worker "$AGY_PID"; return 0
      fi
    fi
  done
}
WATCHDOG_PID=""
rm -f "$SESSION_DIR/.timeout"
if [ "$MAX_RUNTIME" -gt 0 ] || [ "$IDLE_TIMEOUT" -gt 0 ]; then
  echo "  guard:  max-runtime=${MAX_RUNTIME}s idle-timeout=${IDLE_TIMEOUT}s" >&2
  watchdog & WATCHDOG_PID=$!
fi

# ---- start the tail parser; it prints the final answer to stdout ----
[ "${AG_PROGRESS_STDERR:-0}" = "1" ] && export AG_PROGRESS_STDERR
AG_SESSION_DIR="$SESSION_DIR" \
AG_TRANSCRIPT="$TRANSCRIPT" \
AG_DONEFILE="$DONEFILE" \
AG_CONV_ID="$CID" \
AG_PROMPT_PREVIEW="$(printf '%.120s' "$PROMPT")" \
AG_CWD="$CWD" \
AG_BRANCH="$BRANCH" \
AG_MODEL="$MODEL" \
AG_RESUME="$RESUME" \
  node "$PARSER" &
PARSER_PID=$!

# ---- wait for agy, then signal the parser to finalize ----
set +e
wait "$AGY_PID"; AGY_RC=$?
set -e
[ -n "$WATCHDOG_PID" ] && kill_tree "$WATCHDOG_PID" -TERM

if [ -f "$SESSION_DIR/.timeout" ]; then
  TIMEOUT_REASON="$(cat "$SESSION_DIR/.timeout" 2>/dev/null || true)"
  printf 'timeout: %s' "$TIMEOUT_REASON" > "$DONEFILE"
else
  printf '%s' "$AGY_RC" > "$DONEFILE"
fi

wait "$PARSER_PID" 2>/dev/null || true

if [ ! -f "$SESSION_DIR/.timeout" ] && [ "${AGY_RC:-0}" -eq 0 ] && [ -n "$VERIFY_CMD" ]; then
  VERIFY_OUTPUT="$(mktemp -t ag-verify-out-XXXXXX)"
  VERIFY_TAIL="$(mktemp -t ag-verify-tail-XXXXXX)"
  VERIFY_RC=0
  set +e
  ( cd "$CWD" && bash -c "$VERIFY_CMD" ) > "$VERIFY_OUTPUT" 2>&1
  VERIFY_RC=$?
  set -e
  tail -n 20 "$VERIFY_OUTPUT" > "$VERIFY_TAIL" || true
  record_verify_result "$SESSION_DIR" "$VERIFY_CMD" "$VERIFY_RC" "$VERIFY_TAIL" || true
  rm -f "$VERIFY_OUTPUT" "$VERIFY_TAIL"
fi

write_diff_artifacts "$SESSION_DIR" "$CWD" || true
rm -f "$PIDFILE" "${PRE_IDS_FILE:-}" "$SESSION_DIR/.timeout"
exit "$AGY_RC"
