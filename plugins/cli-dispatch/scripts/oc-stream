#!/usr/bin/env bash
# oc-stream — the session-tracked OpenCode (via OpenRouter) worker, mirroring cx-stream
# (structure) with NO sandbox branching (posture mirrors ag-stream).
#
# `opencode run --format json` emits a clean JSONL event stream on stdout, so — like
# cx-stream — this wrapper PIPES opencode's stdout through oc-stream-parse.mjs for live
# progress + a rolling status.json.
#
# NO SANDBOX: OpenCode has no OS-level or tool-level write-deny. `--auto` auto-approves
# every permission prompt — this is NOT a safety opt-in, it is a FUNCTIONAL REQUIREMENT for
# headless use (there is no TTY to answer an interactive approval prompt, so without --auto
# a headless run just hangs). The only safety boundary is git-worktree isolation (same
# posture as the Antigravity/agy backend) — review the diff yourself.
#
# There is also no `-o <file>` clean-output flag like codex has: oc-stream's only source of
# the final answer is the parser's captured finalText, printed to the parser's own stdout.
#
# Usage:
#   oc-stream [--cwd <dir>] [--resume <session-id>] [--model <slug>] \
#             [--max-runtime <s>] [--idle-timeout <s>] -p "<prompt>" [extra opencode flags]
#   echo "<prompt>" | oc-stream [--cwd <dir>]
#
# Session directory: ${XDG_CACHE_HOME:-$HOME/.cache}/cli-dispatch/sessions/<sessionID>/
# (same layout as the other backends, so /cli-dispatch:sessions / watch work for all.)
#
# Auth: OPENROUTER_API_KEY env var (from the config) — no OAuth/login flow. Optional
# OC_MODEL in the config sets --model (oc-stream prepends the "openrouter/" prefix).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$SCRIPT_DIR/stream-utils.sh"

command -v opencode >/dev/null 2>&1 || {
  echo "oc-stream: 'opencode' (OpenCode CLI) not found in PATH." >&2
  echo "  install: npm i -g opencode-ai   (or see https://opencode.ai)" >&2
  exit 1
}
command -v node >/dev/null 2>&1 || { echo "oc-stream: 'node' not found (required for the stream parser)." >&2; exit 1; }

# Optional config (shared across backends). cli-dispatch dir, legacy claude-ds fallback (env wins).
source_config

# Forward the host's gh auth (macOS keyring) into the worker env (issue #56).
maybe_export_gh_token

# OPENROUTER_API_KEY must be exported so the opencode subprocess inherits it — sourcing the
# config only sets a shell variable, not an environment variable, without an explicit export.
[ -n "${OPENROUTER_API_KEY:-}" ] && export OPENROUTER_API_KEY

# Resolve the parser: env > installed location > script dir.
PARSER="${OC_PARSER:-}"
if [ -z "$PARSER" ]; then
  for cand in "$HOME/.local/share/cli-dispatch/oc-stream-parse.mjs" "$HOME/.local/share/claude-ds/oc-stream-parse.mjs" "$SCRIPT_DIR/oc-stream-parse.mjs"; do
    [ -f "$cand" ] && { PARSER="$cand"; break; }
  done
fi
[ -n "$PARSER" ] && [ -f "$PARSER" ] || { echo "oc-stream: oc-stream-parse.mjs not found (set OC_PARSER)." >&2; exit 1; }

# ---- parse arguments ----
CWD="$(pwd)"
RESUME_ID=""
PROMPT=""
HAVE_PROMPT=0
MODEL="${OC_MODEL:-${OPENCODE_MODEL:-}}"
MAX_RUNTIME="${OC_MAX_RUNTIME:-0}"
IDLE_TIMEOUT="${OC_IDLE_TIMEOUT:-0}"
PASS_ARGS=()
need_val() { [ "$2" -ge 2 ] || { echo "oc-stream: $1 requires a value." >&2; exit 1; }; }
while [ "$#" -gt 0 ]; do
  case "$1" in
    --cwd)            need_val --cwd "$#";    CWD="$2"; shift 2;;
    --cwd=*)          CWD="${1#*=}"; shift;;
    --resume)         need_val --resume "$#"; RESUME_ID="$2"; shift 2;;
    --resume=*)       RESUME_ID="${1#*=}"; shift;;
    --model)          need_val --model "$#";  MODEL="$2"; shift 2;;
    --model=*)        MODEL="${1#*=}"; shift;;
    --effort|--effort=*) echo "oc-stream: --effort is not supported by the OpenCode backend (the opencode CLI exposes no reasoning-effort control)." >&2; exit 2;;
    -p|--prompt)      need_val "$1" "$#";     PROMPT="$2"; HAVE_PROMPT=1; shift 2;;
    -p=*)             PROMPT="${1#*=}"; HAVE_PROMPT=1; shift;;
    --prompt=*)       PROMPT="${1#*=}"; HAVE_PROMPT=1; shift;;
    --max-runtime)    need_val --max-runtime "$#";  MAX_RUNTIME="$2"; shift 2;;
    --max-runtime=*)  MAX_RUNTIME="${1#*=}"; shift;;
    --idle-timeout)   need_val --idle-timeout "$#"; IDLE_TIMEOUT="$2"; shift 2;;
    --idle-timeout=*) IDLE_TIMEOUT="${1#*=}"; shift;;
    *)                PASS_ARGS+=("$1"); shift;;
  esac
done

if [ "$HAVE_PROMPT" -eq 0 ]; then
  if [ ! -t 0 ]; then PROMPT="$(cat)"; else
    echo "oc-stream: no prompt. Use -p \"<prompt>\" or pipe via stdin." >&2; exit 1
  fi
fi
# Reject an empty/whitespace-only prompt: opencode run "" produces no useful turn.
if [ -z "${PROMPT//[[:space:]]/}" ]; then
  echo "oc-stream: empty prompt — nothing to delegate." >&2; exit 1
fi
case "$MAX_RUNTIME"  in ''|*[!0-9]*) MAX_RUNTIME=0;;  esac
case "$IDLE_TIMEOUT" in ''|*[!0-9]*) IDLE_TIMEOUT=0;; esac

# The resume id is used as a session-dir path component → reject path-traversal early.
if [ -n "$RESUME_ID" ]; then
  case "$RESUME_ID" in
    */*|*..*) echo "oc-stream: invalid --resume id" >&2; exit 1;;
  esac
fi

# Make CWD absolute.
CWD="$(cd "$CWD" 2>/dev/null && pwd)" || { echo "oc-stream: bad --cwd" >&2; exit 1; }

OC_RESUME_ID="${RESUME_ID:-}"
if [ -n "$RESUME_ID" ]; then
  if [[ "$RESUME_ID" =~ ^oc- ]]; then
    SESSIONS_ROOT_FOR_RESUME="$(resolve_sessions_root)"
    RECORDED_META="$SESSIONS_ROOT_FOR_RESUME/$RESUME_ID/meta.json"
    if [ -f "$RECORDED_META" ]; then
      RECORDED_THREAD_ID="$(sed -n 's/.*"threadId"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$RECORDED_META" 2>/dev/null || true)"
      if [ -n "$RECORDED_THREAD_ID" ]; then
        OC_RESUME_ID="$RECORDED_THREAD_ID"
      fi
    fi
  fi
fi

# ---- build the opencode command ----
# `--auto` is NOT a safety opt-in — it is a FUNCTIONAL REQUIREMENT: headless runs have no TTY
# to answer permission prompts, so without --auto the process hangs forever on the first
# write/exec approval. There is no --read-only / --sandbox flag to add here (unlike cx-stream) —
# OpenCode has no OS-level or tool-level write-deny at all. Safety = git-worktree isolation only.
#
# Resume: `--session <id> --continue`. Confirmed 2026-07-02 against a live OPENROUTER_API_KEY:
# `--session <id>` alone, `--continue` alone, and the two combined all correctly target the
# NAMED session — verified by creating two sessions (A then B), then resuming A specifically
# and confirming the recalled value was A's, not B's (B being "the last session" chronologically
# would have proven a bug; it did not happen). No fix needed here. One caveat observed
# separately (not a flag-semantics bug): a resume whose --cwd/--dir does not match the
# original session's directory can take much longer (full-history replay) — always pass the
# same --cwd used to create the session when resuming it.
OC_ARGS=(run --format json --auto --dir "$CWD")
[ -n "$MODEL" ] && OC_ARGS+=(--model "openrouter/$MODEL")
[ -n "$OC_RESUME_ID" ] && OC_ARGS+=(--session "$OC_RESUME_ID" --continue)
[ "${#PASS_ARGS[@]}" -gt 0 ] && OC_ARGS+=("${PASS_ARGS[@]}")
OC_ARGS+=("$PROMPT")

RESUME=0
[ -n "$RESUME_ID" ] && RESUME=1

# ---- session bookkeeping ----
# The session id is only known once opencode emits its first event (sessionID field). Until
# then we run in a TEMP session dir; the parser captures the id and we relocate to the
# canonical dir (same pattern as cx-stream's thread-id relocation).
SESSIONS_ROOT="$(resolve_sessions_root)"
mkdir -p "$SESSIONS_ROOT"
if [ "$RESUME" -eq 1 ]; then
  SESSION_ID="$RESUME_ID"
else
  SESSION_ID="oc-$(date +%s)-$$"   # provisional; renamed to the real sessionID on completion
fi
SESSION_DIR="$SESSIONS_ROOT/$SESSION_ID"
mkdir -p "$SESSION_DIR"
# Persist THIS wrapper's own pid ($$, NOT $OC_PID) as the worker-tree root. A dashboard
# takeover must kill the ENTIRE headless writer tree — opencode AND the parser (running in a
# process substitution below), both direct children of $$ — before spawning the interactive
# PTY, or the old writers clobber status.json right after takeover starts. A stale worker.pid
# in a finished session is harmless: the dashboard only acts on it while status.json
# state=="running". (This dir may later be relocated wholesale via `mv` — worker.pid moves
# with it.)
printf '%s' "$$" > "$SESSION_DIR/worker.pid" 2>/dev/null || true
printf '%s' "$PROMPT" > "$SESSION_DIR/prompt.txt" 2>/dev/null || true
BRANCH="$(git -C "$CWD" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"

# Process helpers: mtime_of, kill_tree, proc_tree, kill_worker — defined in stream-utils.sh
# (sourced above). Defined before launch; the watchdog reuses them.

echo "oc-stream → OpenCode (OpenRouter) worker" >&2
echo "  cwd:     $CWD" >&2
echo "  sandbox: none — git-worktree isolation is the only safety boundary (see oc-runner.md)" >&2
[ -n "$MODEL" ] && echo "  model:   openrouter/$MODEL" >&2
[ "$RESUME" -eq 1 ] && echo "  resume:  $RESUME_ID" >&2
echo "  dir:     $SESSION_DIR" >&2
echo "  status:  $SESSION_DIR/status.json" >&2

# ---- launch opencode; pipe its JSONL stdout through the parser ----
# opencode stdout (JSONL) → parser; opencode stderr → our stderr. The parser writes
# status.json and prints the captured final text on ITS stdout (the ONLY answer source —
# no -o <file> equivalent exists for opencode).
PARSER_OUT="$(mktemp -t oc-parsed-XXXXXX)"
DONEFILE="$SESSION_DIR/.oc.done"; rm -f "$DONEFILE" "$SESSION_DIR/.timeout"

# Launch opencode as a DIRECT background job whose stdout feeds the parser via a PROCESS
# SUBSTITUTION (same rationale as cx-stream: $! must be opencode's REAL pid so the watchdog
# targets the right process and `wait` yields opencode's TRUE exit code; process substitution
# uses an anonymous pipe so EOF is delivered cleanly, unlike a FIFO).
PARSER_DONE="$(mktemp -u -t oc-pdone-XXXXXX)"

# Clean up ALL temp files + reap the watchdog (and the opencode worker) on ANY exit path —
# normal, error, or signal (Ctrl-C) — so nothing leaks and the watchdog can't outlive us.
cleanup() {
  [ -n "${WATCHDOG_PID:-}" ] && kill "$WATCHDOG_PID" 2>/dev/null || true
  [ -n "${OC_PID:-}" ] && kill -TERM "$OC_PID" 2>/dev/null || true
  rm -f "$PARSER_OUT" "$PARSER_DONE" 2>/dev/null || true
}
trap cleanup EXIT

# On an EXTERNAL SIGINT/SIGTERM — a dashboard takeover-kill of this headless worker tree, or a
# user Ctrl-C — the post-`wait` reconcile block below never runs (the wrapper is blocked in
# `wait` when the signal arrives), so status.json is left at whatever the parser last wrote —
# "running", or a blind "done" the parser writes on opencode-stdout EOF — NEVER recorded as the
# abnormal termination it was. Force the record to "error" with the real signal exit code
# (130 INT / 143 TERM). `trap - INT TERM` at the top is the re-entry guard (also stops a second
# signal from double-firing); the EXIT trap still runs cleanup once more (idempotent) after the
# exit below. Takeover-safety: killWorkerTree TERMs this WHOLE tree (wrapper + opencode + parser)
# and WAITS for it to die (then SIGKILLs) BEFORE the takeover PTY writes state:"human-controlled"
# — so either our error-write lands and is then overwritten by the PTY, or we are killed before
# reconciling and the PTY sets the record; either way we cannot clobber a human-controlled record.
handle_interrupt() {
  local sig="$1" rc="$2"
  trap - INT TERM
  echo "oc-stream: interrupted ($sig)." >&2
  # Stop opencode so its stdout closes and the parser (a process-substitution child, whose pid
  # we can't `wait` on) drains to EOF and runs its finalize — a blind status.json "done". Then
  # WAIT (bounded) for that finalize to land: the parser touches PARSER_DONE only AFTER writing
  # status.json, so reconciling only once PARSER_DONE exists guarantees our "error" is written
  # LAST and is not clobbered by the parser's "done" (this is the exact ordering the normal
  # post-`wait` block relies on). If the parser was already signalled dead (Ctrl-C to the
  # process group, or a dashboard tree-kill), PARSER_DONE never arrives and we fall through
  # after the bound and reconcile anyway.
  [ -n "${OC_PID:-}" ] && kill_tree "$OC_PID" -TERM 2>/dev/null || true
  for _ in $(seq 1 30); do [ -e "${PARSER_DONE:-/nonexistent}" ] && break; sleep 0.1; done
  reconcile_session_error "$SESSION_DIR" "interrupted: $sig" "$rc"
  cleanup
  exit "$rc"
}
trap 'handle_interrupt INT 130' INT
trap 'handle_interrupt TERM 143' TERM

# For the session record only: when no model was requested anywhere, surface opencode's own
# config default so the dashboard can show the model actually used. NOT added to OC_ARGS —
# opencode applies this default itself. No effort/reasoning config-default field exists for
# OpenCode, so effort labeling is intentionally left as-is (unlike cx-stream's META_EFFORT).
OC_META_MODEL=""
if [ -z "$MODEL" ]; then
  OC_CONFIG_FILE=""
  if [ -n "${OPENCODE_CONFIG:-}" ]; then
    OC_CONFIG_FILE="$OPENCODE_CONFIG"
  elif [ -n "${OPENCODE_CONFIG_DIR:-}" ]; then
    OC_CONFIG_FILE="$OPENCODE_CONFIG_DIR/opencode.jsonc"
    [ -f "$OC_CONFIG_FILE" ] || OC_CONFIG_FILE="$OPENCODE_CONFIG_DIR/opencode.json"
  else
    _d="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
    OC_CONFIG_FILE="$_d/opencode.jsonc"
    [ -f "$OC_CONFIG_FILE" ] || OC_CONFIG_FILE="$_d/opencode.json"
  fi
  if [ -f "$OC_CONFIG_FILE" ]; then
    OC_META_MODEL="$(sed -n 's/^[[:space:]]*"model"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$OC_CONFIG_FILE" 2>/dev/null | head -1)"
  fi
fi

# opencode's stdout → parser (process substitution); opencode's stderr passes through to our
# stderr. No stdin redirect needed (unlike codex's prompt-as-arg gotcha) — but redirect from
# /dev/null anyway for parity/safety, since opencode is not expected to read stdin either.
opencode "${OC_ARGS[@]}" </dev/null > >(
  OC_SESSION_DIR="$SESSION_DIR" \
  OC_PROMPT_PREVIEW="$(printf '%.120s' "$PROMPT")" \
  OC_CWD="$CWD" \
  OC_BRANCH="$BRANCH" \
  OC_MODEL="${MODEL:-$OC_META_MODEL}" \
  OC_THREAD_ID="$([ "$RESUME" -eq 1 ] && printf '%s' "$OC_RESUME_ID" || true)" \
  OC_RESUME="$RESUME" \
    node "$PARSER" > "$PARSER_OUT"
  touch "$PARSER_DONE"
) &
OC_PID=$!

# The watchdog watches opencode itself for liveness and TARGETS the real opencode pid for the kill.
PIPE_PID="$OC_PID"

# ---- watchdog: runtime cap + idle on status.json mtime (best-effort) ----
TRANSCRIPT="$SESSION_DIR/transcript.jsonl"
WATCHDOG_PID=""
if [ "$MAX_RUNTIME" -gt 0 ] || [ "$IDLE_TIMEOUT" -gt 0 ]; then
  echo "  guard:   max-runtime=${MAX_RUNTIME}s idle-timeout=${IDLE_TIMEOUT}s" >&2
  watchdog & WATCHDOG_PID=$!
fi

# ---- wait for opencode + parser to finish ----
# Wait on the opencode job FIRST: its exit status is opencode's REAL exit code (direct bg job).
set +e
wait "$OC_PID"; OC_RC=$?
set -e
[ -n "$WATCHDOG_PID" ] && kill_tree "$WATCHDOG_PID" -TERM
case "$OC_RC" in ''|*[!0-9]*) OC_RC=1;; esac

# The parser runs in a process substitution (not a job we can `wait` on), so synchronize on
# its done-marker: it touches PARSER_DONE only AFTER draining stdin and writing status.json.
# Bounded poll so we never hang if the parser died early.
for _ in $(seq 1 100); do
  [ -e "$PARSER_DONE" ] && break
  sleep 0.1
done

# ---- human-controlled guard (defense-in-depth) ----
# If a human already took over this session, the dashboard tree-killed the WHOLE worker
# (via worker.pid, see above) and spawned an interactive PTY that now owns status.json,
# writing state:"human-controlled". That kill normally reaps this wrapper before it ever
# gets here — but if it raced or somehow missed us, this guard stops the finalize logic
# below (reconcile_session_error / surface_status_error / relocate_session_dir) from
# clobbering the dashboard's record. Exit 0 so the caller sees a clean exit; the EXIT trap
# (cleanup) still runs.
TAKEOVER_STATE="$(json_field "$SESSION_DIR/status.json" state || true)"
if [ "$TAKEOVER_STATE" = "human-controlled" ]; then
  echo "oc-stream: session taken over by a human — leaving record to the dashboard." >&2
  exit 0
fi

if [ -f "$SESSION_DIR/.timeout" ]; then
  TIMEOUT_REASON="$(cat "$SESSION_DIR/.timeout" 2>/dev/null || true)"
  printf 'timeout: %s' "$TIMEOUT_REASON" > "$DONEFILE"
  echo "oc-stream: stopped by watchdog ($TIMEOUT_REASON)." >&2
  # A watchdog stop is always a failure, regardless of opencode's reported rc.
  [ "$OC_RC" -eq 0 ] && OC_RC=124
  # The parser only saw stdin EOF and finalized "done"/exitCode:0 — fix the record.
  reconcile_session_error "$SESSION_DIR" "timeout: $TIMEOUT_REASON" "$OC_RC"
else
  if [ "$OC_RC" -ne 0 ]; then
    OC_STATE=""
    [ -f "$SESSION_DIR/status.json" ] && OC_STATE="$(json_field "$SESSION_DIR/status.json" state || true)"
    if [ "$OC_STATE" = "done" ] || [ -z "$OC_STATE" ]; then
      reconcile_session_error "$SESSION_DIR" "opencode exited with code $OC_RC" "$OC_RC"
    fi
  fi
  printf '%s' "$OC_RC" > "$DONEFILE"
fi

# ---- H2: consult the parser's result; turn-level errors must propagate ----
# Confirmed 2026-07-02 against a live OPENROUTER_API_KEY: OpenCode emits a top-level
# {"type":"error",...} event on a turn failure (bad model slug, no tool-use-capable endpoint,
# upstream 5xx, etc) — the parser captures it into status.json state=error (+ error message).
# Surface the reason on stderr and force a non-zero exit so callers don't see "success" with
# no output.
if ! surface_status_error "$SESSION_DIR" "oc-stream: opencode turn failed"; then
  [ "$OC_RC" -eq 0 ] && OC_RC=1
fi

# ---- relocate the provisional session dir to the real sessionID (best-effort) ----
if [ "$RESUME" -eq 0 ]; then
  REAL_ID="$(json_field "$SESSION_DIR/meta.json" threadId || true)"
  # relocate_session_dir warns (not clobbers) if the real session dir already exists, echoes
  # the discovered "  session: <id>" line, and prints the resulting dir for us to capture.
  SESSION_DIR="$(relocate_session_dir "$SESSIONS_ROOT" "$SESSION_DIR" "$SESSION_ID" "$REAL_ID" "oc-stream" "session dir" "  session: ")"
fi

# ---- print ONLY the final answer on stdout ----
# No -o <file> equivalent exists for opencode — the parser's captured finalText (printed to
# PARSER_OUT) is the SOLE source of the answer.
[ -s "$PARSER_OUT" ] && cat "$PARSER_OUT"

rm -f "$SESSION_DIR/.timeout" 2>/dev/null || true
# Temp files (PARSER_OUT/PARSER_DONE) are removed by the EXIT trap.
exit "$OC_RC"
