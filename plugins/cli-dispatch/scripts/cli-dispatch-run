#!/usr/bin/env bash
# cli-dispatch-run — bootstrap worker sessions and write deterministic verdict artifacts.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'USAGE' >&2
usage: cli-dispatch-run --backend <ds|ag|cx|oc|cp> --cwd <repo> [--prompt <text> | --prompt-file <path>] [--branch <name>] [--model <slug>] [--effort low|medium|high] [--verify <cmd>] [--verify-timeout SECS] [--timeout SECS] [--resume <session-id>] [--cleanup-if-clean]
USAGE
}

need_val() {
  if [ "$2" -lt 2 ]; then
    echo "cli-dispatch-run: $1 requires a value." >&2
    usage
    exit 5
  fi
}

cleanup_tmp() {
  [ "${#TEMP_FILES[@]}" -gt 0 ] || return 0
  rm -f "${TEMP_FILES[@]}" 2>/dev/null || true
}

is_worktree_clean() {
  local worktree="$1"
  local status_out

  [ -n "$worktree" ] || return 1
  [ -d "$worktree" ] || return 1
  status_out="$(git -C "$worktree" status --short 2>/dev/null || true)"
  [ -z "$status_out" ]
}

canonical_path() {
  # realpath(1) is not on every macOS/BSD box; cd + pwd -P is.
  local p="$1"
  [ -n "$p" ] || return 0
  ( cd "$p" 2>/dev/null && pwd -P ) || printf '%s' "$p"
}

cleanup_worktree_if_requested() {
  local worktree_path="$1"
  local verdict_exit_code="$2"

  if [ -z "$worktree_path" ]; then
    echo "cli-dispatch-run: no worktree path found; kept path unknown"
    return 0
  fi

  if [ "$CLEANUP_IF_CLEAN" -ne 1 ]; then
    echo "cli-dispatch-run: --cleanup-if-clean not set; kept worktree at $worktree_path"
    return 0
  fi

  # NEVER touch the directory the caller handed us via --cwd (issue #108). In in-place
  # mode the session's cwd IS that directory, so an unguarded `worktree remove --force`
  # here would delete work the caller owns. The runner only ever cleans up worktrees it
  # created itself. Two independent belts: the runner's own `in-place=1` marker (the mode
  # it actually took), and a resolved-path comparison (catches --resume, where the marker
  # from the original launch is no longer on this run's stderr).
  if [ "${IN_PLACE_RUN:-0}" = "1" ]; then
    echo "cli-dispatch-run: worker ran in-place in the caller's worktree; leaving it untouched: $worktree_path"
    return 0
  fi
  if [ -n "$CWD" ] && [ "$(canonical_path "$worktree_path")" = "$(canonical_path "$CWD")" ]; then
    echo "cli-dispatch-run: worktree is the caller-provided --cwd; leaving it untouched: $worktree_path"
    return 0
  fi

  if [ "$verdict_exit_code" -ne 0 ]; then
    echo "cli-dispatch-run: kept worktree because verdict exit code is $verdict_exit_code (expected 0): $worktree_path"
    return 0
  fi

  if ! is_worktree_clean "$worktree_path"; then
    local status_out
    status_out="$(git -C "$worktree_path" status --short 2>/dev/null || true)"
    echo "cli-dispatch-run: kept worktree because it is dirty:"
    if [ -n "$status_out" ]; then echo "$status_out"; fi
    echo "cli-dispatch-run: kept worktree at $worktree_path"
    echo "cli-dispatch-run: manual cleanup: git -C \"$worktree_path\" worktree remove \"$worktree_path\" --force"
    return 0
  fi

  if ! git -C "$worktree_path" worktree remove "$worktree_path" --force; then
    echo "cli-dispatch-run: git worktree remove failed for clean worktree; fallback to rm -rf: $worktree_path"
    rm -rf "$worktree_path"
  fi

  if [ -d "$worktree_path" ]; then
    echo "cli-dispatch-run: clean signals met but worktree still present; kept at $worktree_path"
    echo "cli-dispatch-run: manual cleanup: git -C \"$worktree_path\" worktree remove \"$worktree_path\" --force"
  else
    echo "cli-dispatch-run: removed clean worktree at $worktree_path"
    record_worktree_removed
  fi
}

# Extracted from the main flow (it used to be inline just before read_json_field) so the
# --_test-cleanup path can reach it too: recording worktreeRemoved needs node. Idempotent —
# calling it twice re-resolves the same two values. Kept BELOW the argument validation in the
# normal flow so a plain `cli-dispatch-run` with bad args still prints usage rather than
# complaining about node.
resolve_node_and_verdict_writer() {
  NODE_BIN="${CLI_DISPATCH_NODE:-}"
  if [ -z "$NODE_BIN" ]; then
    NODE_BIN="$HOME/.local/share/cli-dispatch/node"
    if [ ! -x "$NODE_BIN" ]; then
      NODE_BIN="node"
    fi
  fi
  if ! command -v "$NODE_BIN" >/dev/null 2>&1; then
    echo "cli-dispatch-run: node not found in PATH" >&2
    exit 1
  fi

  VERDICT_WRITER="${CLI_DISPATCH_VERDICT_WRITER:-}"
  if [ -z "$VERDICT_WRITER" ]; then
    for cand in "$HOME/.local/share/cli-dispatch/verdict-writer.mjs" "$HOME/.local/share/claude-ds/verdict-writer.mjs" "$SCRIPT_DIR/verdict-writer.mjs"; do
      [ -f "$cand" ] && { VERDICT_WRITER="$cand"; break; }
    done
  fi
  [ -n "$VERDICT_WRITER" ] && [ -f "$VERDICT_WRITER" ] || { echo "cli-dispatch-run: verdict-writer.mjs not found" >&2; exit 1; }
}

record_worktree_removed() {
  # Issue #128: verdict.json is written BEFORE this cleanup runs (it is the escalation artifact
  # and must exist even if cleanup dies), so `worktreeRemoved` can only be recorded here, after
  # the removal actually happened. Called from the ONE branch that proved the directory is gone.
  #
  # Never fatal: the run is over, the verify verdict is on disk and the worktree really is gone.
  # A failed bookkeeping write must not change the run's exit code.
  [ -n "${SESSION_DIR:-}" ] || return 0
  [ -f "$SESSION_DIR/verdict.json" ] || return 0
  [ -n "${NODE_BIN:-}" ] && [ -n "${VERDICT_WRITER:-}" ] || return 0
  "$NODE_BIN" "$VERDICT_WRITER" mark-worktree-removed "$SESSION_DIR/verdict.json" ||
    echo "cli-dispatch-run: could not record worktreeRemoved in verdict.json" >&2
  return 0
}


build_and_write_verdict() {
  set +e
  if [ -n "$VERIFY_RESULTS_PATH" ]; then
    VERDICT_JSON="$($NODE_BIN "$VERDICT_WRITER" build-verdict "$SESSION_DIR" "$STATUS_PATH" "$META_PATH" "$CHANGED_PATH" "$TIMEOUT_EXPIRED" "$VERIFY_RESULTS_PATH")"
    BUILD_EXIT=$?
  else
    VERDICT_JSON="$($NODE_BIN "$VERDICT_WRITER" build-verdict "$SESSION_DIR" "$STATUS_PATH" "$META_PATH" "$CHANGED_PATH" "$TIMEOUT_EXPIRED")"
    BUILD_EXIT=$?
  fi
  set -e

  # build-verdict produced no output → verdict could not be built. This is a setup error
  # regardless of what exit status the helper reported (it may exit 0 having printed nothing,
  # e.g. when its own guard silently no-ops). The error shape exitCode here is the contract
  # value (5 = setup error), not a node exit status — unlike the normal path below where
  # BUILD_EXIT carries the worker result. Still write valid JSON so downstream JSON.parse
  # consumers do not crash.
  if [ -z "$VERDICT_JSON" ]; then
    VERDICT_JSON="{\"schemaVersion\":1,\"error\":\"build-verdict failed (exit $BUILD_EXIT) — see stderr\",\"sessionId\":\"$SESSION_ID\",\"exitCode\":5}"
    printf '%s\n' "$VERDICT_JSON" > "$SESSION_DIR/verdict.json"
    printf '%s\n' "cli-dispatch-run: verdict could not be built — reporting exit code 5" >&2
    cleanup_worktree_if_requested "$WORKTREE_PATH" 5
    exit 5
  fi
  printf '%s\n' "$VERDICT_JSON" > "$SESSION_DIR/verdict.json"
  cleanup_worktree_if_requested "$WORKTREE_PATH" "$BUILD_EXIT"
  exit "$BUILD_EXIT"
}
trap cleanup_tmp EXIT INT TERM

BACKEND=""
CWD=""
PROMPT=""
PROMPT_FILE=""
BRANCH=""
MODEL=""
EFFORT=""
VERIFY_TIMEOUT=600
TIMEOUT=0
RESUME=""
VERIFY=()
TEST_MODE=0
TEST_WORKTREE=""
TEST_EXIT_CODE=0
TEST_SESSION_DIR=""
CLEANUP_IF_CLEAN=0
IN_PLACE_RUN=0
TEMP_FILES=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --backend) need_val --backend "$#"; BACKEND="$2"; shift 2;;
    --cwd) need_val --cwd "$#"; CWD="$2"; shift 2;;
    --prompt) need_val --prompt "$#"; PROMPT="$2"; shift 2;;
    --prompt-file) need_val --prompt-file "$#"; PROMPT_FILE="$2"; shift 2;;
    --branch) need_val --branch "$#"; BRANCH="$2"; shift 2;;
    --model) need_val --model "$#"; MODEL="$2"; shift 2;;
    --effort) need_val --effort "$#"; EFFORT="$2"; shift 2;;
    --verify) need_val --verify "$#"; VERIFY+=("$2"); shift 2;;
    --verify-timeout) need_val --verify-timeout "$#"; VERIFY_TIMEOUT="$2"; shift 2;;
    --timeout) need_val --timeout "$#"; TIMEOUT="$2"; shift 2;;
    --resume) need_val --resume "$#"; RESUME="$2"; shift 2;;
    --cleanup-if-clean) CLEANUP_IF_CLEAN=1; shift;;
    --_test-cleanup)
      # Takes TWO values (worktree + exit code) — need_val only proves one is present,
      # and under `set -u` a short call would abort on $3 with "unbound variable".
      if [ "$#" -lt 3 ]; then
        echo "cli-dispatch-run: --_test-cleanup requires <worktree> <exit-code>." >&2
        exit 5
      fi
      TEST_MODE=1
      TEST_WORKTREE="$2"
      TEST_EXIT_CODE="$3"
      shift 3
      # Optional THIRD value: a session dir, so a test can drive the worktreeRemoved
      # bookkeeping (issue #128) as well as the removal itself. Guarded on "not another
      # flag" so the existing two-value call sites keep working untouched.
      if [ "$#" -gt 0 ] && [ "${1#--}" = "$1" ]; then
        TEST_SESSION_DIR="$1"
        shift
      fi
      ;;
    --_test-verdict-build)
      # Internal test hook: jump directly to verdict-build with a pre-seeded
      # session dir. Takes one value (the session dir path).
      if [ "$#" -lt 2 ]; then
        echo "cli-dispatch-run: --_test-verdict-build requires <session-dir>." >&2
        exit 5
      fi
      TEST_VERDICT_BUILD=1
      TEST_SESSION_DIR_FOR_VERDICT="$2"
      shift 2
      ;;
    -h|--help) usage; exit 0;;
    *) echo "cli-dispatch-run: unknown arg: $1" >&2; usage; exit 5;;
  esac
done

if [ "$TEST_MODE" -eq 1 ]; then
  # Only when the test asked for the bookkeeping half: SESSION_DIR is what
  # record_worktree_removed keys on, and resolving node is pointless without it.
  if [ -n "$TEST_SESSION_DIR" ]; then
    SESSION_DIR="$TEST_SESSION_DIR"
    resolve_node_and_verdict_writer
  fi
  cleanup_worktree_if_requested "$TEST_WORKTREE" "$TEST_EXIT_CODE"
  exit 0
fi


# Test hook: seed session variables from a pre-seeded dir and call the shared
# verdict-build function. Mirrors the --_test-cleanup pattern: early exit before
# the normal flow begins, leaving the production path unconditional.
if [ "${TEST_VERDICT_BUILD:-0}" -eq 1 ]; then
  SESSION_DIR="$TEST_SESSION_DIR_FOR_VERDICT"
  SESSION_ID="$(basename "$SESSION_DIR")"
  resolve_node_and_verdict_writer
  STATUS_PATH="$SESSION_DIR/status.json"
  META_PATH="$SESSION_DIR/meta.json"
  CHANGED_PATH="$SESSION_DIR/changed-files.json"
  STATE="$("$NODE_BIN" -e 'try{process.stdout.write(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).state||"")}catch{}' "$STATUS_PATH")"
  WORKTREE_PATH="$("$NODE_BIN" -e 'try{process.stdout.write(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).cwd||"")}catch{}' "$META_PATH")"
  TIMEOUT_EXPIRED=0
  VERIFY_RESULTS_PATH=""
  CLEANUP_IF_CLEAN=0
  build_and_write_verdict
  # build_and_write_verdict always exits; this line is unreachable.
fi

if [ -z "$BACKEND" ] || [ -z "$CWD" ]; then
  usage
  exit 5
fi

if [ -z "$RESUME" ] && [ -z "$PROMPT$PROMPT_FILE" ]; then
  echo "cli-dispatch-run: --prompt or --prompt-file is required" >&2
  usage
  exit 5
fi
if [ -n "$PROMPT" ] && [ -n "$PROMPT_FILE" ]; then
  echo "cli-dispatch-run: use only one of --prompt and --prompt-file" >&2
  usage
  exit 5
fi
if [ -n "$PROMPT_FILE" ] && [ ! -f "$PROMPT_FILE" ]; then
  echo "cli-dispatch-run: prompt file not found: $PROMPT_FILE" >&2
  exit 1
fi

case "$BACKEND" in
  ds|ag|cx|oc|cp) ;;
  *) echo "cli-dispatch-run: unknown backend '$BACKEND'" >&2; exit 5;;
esac

case "$EFFORT" in
  ''|low|medium|high) ;;
  *) echo "cli-dispatch-run: --effort must be low|medium|high" >&2; usage; exit 5;;
esac

ROOT="${CLI_DISPATCH_SESSIONS_DIR:-${CLAUDE_DS_SESSIONS_DIR:-}}"
[ -n "$ROOT" ] || { _c="${XDG_CACHE_HOME:-$HOME/.cache}"; ROOT="$_c/cli-dispatch/sessions"; [ -d "$ROOT" ] || [ ! -d "$_c/claude-ds/sessions" ] || ROOT="$_c/claude-ds/sessions"; }
SESSIONS_ROOT="$ROOT"

resolve_node_and_verdict_writer

read_json_field() {
  local file="$1"
  local key="$2"
  "$NODE_BIN" --input-type=module -e '
    import fs from "node:fs"
    const file = process.argv[1]
    const key = process.argv[2]
    try {
      const parsed = JSON.parse(fs.readFileSync(file, "utf8"))
      const value = parsed?.[key]
      if (value !== undefined && value !== null) process.stdout.write(String(value))
    } catch {}
  ' "$file" "$key"
}

select_runner() {
  local backend="$1"
  case "$backend" in
    ds) echo "$SCRIPT_DIR/ds-worktree-run.sh" ;;
    ag) echo "$SCRIPT_DIR/ag-worktree-run.sh" ;;
    cx) echo "$SCRIPT_DIR/cx-worktree-run.sh" ;;
    oc) echo "$SCRIPT_DIR/oc-worktree-run.sh" ;;
    cp) echo "$SCRIPT_DIR/cp-worktree-run.sh" ;;
  esac
}

WORKTREE_RUN="$(select_runner "$BACKEND")"
[ -n "$WORKTREE_RUN" ] && [ -x "$WORKTREE_RUN" ] || { echo "cli-dispatch-run: backend runner not found: $WORKTREE_RUN" >&2; exit 5; }

WORKTREE_BASE_VARS=()
if [ -n "$MODEL" ]; then
  case "$BACKEND" in
    ds) WORKTREE_BASE_VARS+=("DS_MODEL=$MODEL");;
    ag) WORKTREE_BASE_VARS+=("AG_MODEL=$MODEL");;
    cx) WORKTREE_BASE_VARS+=("CX_MODEL=$MODEL");;
    oc) WORKTREE_BASE_VARS+=("OC_MODEL=$MODEL");;
    cp) WORKTREE_BASE_VARS+=("CP_MODEL=$MODEL");;
  esac
fi
if [ -n "$EFFORT" ]; then
  case "$BACKEND" in
    ds) WORKTREE_BASE_VARS+=("DS_EFFORT=$EFFORT");;
    ag) WORKTREE_BASE_VARS+=("AG_EFFORT=$EFFORT");;
    cx) WORKTREE_BASE_VARS+=("CX_EFFORT=$EFFORT");;
    oc) WORKTREE_BASE_VARS+=("OC_EFFORT=$EFFORT");;
    cp) WORKTREE_BASE_VARS+=("CP_EFFORT=$EFFORT");;
  esac
fi

if [ -n "$RESUME" ]; then
  # --resume RE-ATTACHES to an existing session (wait → verify → verdict); it does NOT
  # send a new prompt to the worker. Reject a prompt loudly instead of ignoring it.
  if [ -n "$PROMPT" ] || [ -n "$PROMPT_FILE" ]; then
    echo "cli-dispatch-run: --resume re-attaches to a session and cannot take a prompt — use /cli-dispatch:resume <id> \"<follow-up>\" to continue the conversation" >&2
    exit 5
  fi
  SESSION_ID="$RESUME"
  SESSION_DIR="$SESSIONS_ROOT/$SESSION_ID"
  if [ ! -d "$SESSION_DIR" ]; then
    echo "cli-dispatch-run: no such session: $SESSION_ID" >&2
    exit 5
  fi
else
  # Build the brief the worker actually sees: caller text + the standing cwd contract.
  # The caller's own --prompt-file is never modified in place; we always write a copy.
  # CLI_DISPATCH_NO_CWD_CONTRACT=1 opts out.
  PROMPT_FILE_TMP="$(mktemp)"
  TEMP_FILES+=("$PROMPT_FILE_TMP")
  if [ -n "$PROMPT_FILE" ]; then
    cat "$PROMPT_FILE" > "$PROMPT_FILE_TMP"
  else
    printf '%s' "$PROMPT" > "$PROMPT_FILE_TMP"
  fi
  if [ "${CLI_DISPATCH_NO_CWD_CONTRACT:-0}" != "1" ]; then
    # Workers have reported "ruff: all checks passed" after running the check in the tree
    # they were started in rather than the tree they edited — linting untouched originals
    # (issue #109). Pin every self-check to the working directory explicitly.
    cat >> "$PROMPT_FILE_TMP" <<'CWD_CONTRACT'

---
[cli-dispatch] Working-directory contract — applies to every command you run:
- Print your working directory first. That directory is the ONLY tree you may read or edit;
  state it in your report.
- Make that directory the process working directory for EVERY verification command (lint,
  tests, build, type-check) before running it. A check run anywhere else inspects untouched
  copies and produces false "all checks passed" claims.
- Report the exact command AND the directory it ran in for each result you claim.
- Your self-reported results are not the gate: the caller re-runs the verification chain
  independently, and only that run counts.
CWD_CONTRACT
  fi
  PROMPT_FILE="$PROMPT_FILE_TMP"
  BRANCH="${BRANCH:-${BACKEND}-run-$(date +%s)-$$}"
  WORKTREE_STDERR="$(mktemp)"
  LAUNCH_MARKER="$(mktemp)"
  TEMP_FILES+=("$WORKTREE_STDERR" "$LAUNCH_MARKER")
  touch "$LAUNCH_MARKER"

  # Each stream wrapper prints the FINAL session id on stderr (post-relocation for
  # cx/oc/cp provisional dirs): ds "claude-ds session: <id>", cx "  thread:  <id>",
  # ag "  conv:   <id>", oc/cp "  session: <id>". Verified against the *-stream sources.
  MARKER=""
  case "$BACKEND" in
    ds) MARKER='claude-ds session:';;
    cx) MARKER='thread:';;
    ag) MARKER='conv:';;
    oc) MARKER='session:';;
    cp) MARKER='session:';;
  esac

  # Pipe (not process substitution): the pipeline only returns once tee has flushed
  # $WORKTREE_STDERR completely, so the marker grep below never reads a partial file.
  # PIPESTATUS[0] recovers the runner's own exit code (tee's is irrelevant).
  set +e
  if [ "${#WORKTREE_BASE_VARS[@]}" -gt 0 ]; then
    env "${WORKTREE_BASE_VARS[@]}" "$WORKTREE_RUN" "$CWD" "$BRANCH" "$PROMPT_FILE" </dev/null 2>&1 >/dev/null | tee "$WORKTREE_STDERR" >&2
  else
    "$WORKTREE_RUN" "$CWD" "$BRANCH" "$PROMPT_FILE" </dev/null 2>&1 >/dev/null | tee "$WORKTREE_STDERR" >&2
  fi
  WORKTREE_RC=${PIPESTATUS[0]}
  set -e

  # The runner prints `>>> cli-dispatch: in-place=1` when it decided to run the worker in
  # the caller's own worktree. Cleanup keys off this MODE, not just a path comparison.
  if grep -aq '^>>> cli-dispatch: in-place=1' "$WORKTREE_STDERR" 2>/dev/null; then
    IN_PLACE_RUN=1
  fi

  if [ "$WORKTREE_RC" -ne 0 ]; then
    echo "cli-dispatch-run: worktree runner failed (code $WORKTREE_RC)" >&2
    exit "$WORKTREE_RC"
  fi

  # `|| true`: under set -e a no-match grep would kill the script SILENTLY before the
  # newest-dir fallback below ever runs (this stranded verified work in production).
  SESSION_ID="$(grep -aoE "${MARKER}[[:space:]]*[A-Za-z0-9._-]+" "$WORKTREE_STDERR" | sed -E "s/.*${MARKER}[[:space:]]*([A-Za-z0-9._-]+)\$/\\1/" | tail -n 1 || true)"
  if [ -z "$SESSION_ID" ]; then
    SESSION_ID="$(find "$SESSIONS_ROOT" -mindepth 1 -maxdepth 1 -type d -newer "$LAUNCH_MARKER" -print0 2>/dev/null | xargs -0 ls -1dt 2>/dev/null | head -n 1)"
  fi

  if [ -z "$SESSION_ID" ]; then
    echo "cli-dispatch-run: failed to discover session id" >&2
    exit 5
  fi

  SESSION_DIR="$SESSION_ID"
  if [ "${SESSION_DIR#/}" = "$SESSION_DIR" ]; then
    SESSION_DIR="$SESSIONS_ROOT/$SESSION_DIR"
  fi

  if [ ! -d "$SESSION_DIR" ]; then
    echo "cli-dispatch-run: session dir not found: $SESSION_DIR" >&2
    exit 5
  fi
fi

STATUS_PATH="$SESSION_DIR/status.json"
META_PATH="$SESSION_DIR/meta.json"
CHANGED_PATH="$SESSION_DIR/changed-files.json"

STATE="$(read_json_field "$STATUS_PATH" state)"
WORKTREE_PATH="$(read_json_field "$META_PATH" cwd)"
[ -n "$WORKTREE_PATH" ] || WORKTREE_PATH="$CWD"

SECS_ELAPSED=0
while :; do
  set +e
  CLI_DISPATCH_NODE="$NODE_BIN" "$SCRIPT_DIR/cli-dispatch-wait" "$SESSION_ID" --timeout 30
  WAIT_RC=$?
  set -e

  STATE="$(read_json_field "$STATUS_PATH" state)"
  if [ "$STATE" = "human-controlled" ]; then
    echo "cli-dispatch-run: human control requested" >&2
    exit 4
  fi

  if [ "$WAIT_RC" -eq 0 ]; then
    break
  fi

  if [ "$WAIT_RC" -eq 2 ]; then
    if [ "$TIMEOUT" -ne 0 ]; then
      SECS_ELAPSED=$((SECS_ELAPSED + 30))
      if [ "$SECS_ELAPSED" -lt "$TIMEOUT" ]; then
        continue
      fi
    else
      continue
    fi
  fi

  break
done

TIMEOUT_EXPIRED=0
if [ "$TIMEOUT" -ne 0 ] && [ "$SECS_ELAPSED" -ge "$TIMEOUT" ] && [ "$STATE" != "done" ]; then
  TIMEOUT_EXPIRED=1
fi

DIFF_PATCH_PATH="$SESSION_DIR/verdict-diff.patch"
: > "$DIFF_PATCH_PATH"
# Worktree may already be gone (e.g. --cleanup-if-clean then --resume) — under
# `set -e` an unguarded `git -C` would exit 128 and kill the run before verdict.json
# is written. Guard it and fall through to an empty diff like the PS1 twin does.
if [ -n "$WORKTREE_PATH" ] && [ -d "$WORKTREE_PATH" ]; then
  git -C "$WORKTREE_PATH" status --short --untracked-files=all > "$DIFF_PATCH_PATH"
  git -C "$WORKTREE_PATH" diff HEAD >> "$DIFF_PATCH_PATH"
fi

VERIFY_RESULTS_PATH=""
if [ "${#VERIFY[@]}" -gt 0 ] && [ "$STATE" != "human-controlled" ]; then
  VERIFY_RESULTS_PATH="$(mktemp)"
  TEMP_FILES+=("$VERIFY_RESULTS_PATH")
  VERIFY_TIMEOUT_MS=$((VERIFY_TIMEOUT * 1000))
  # run-verify must not abort the script under `set -e`: verdict.json is the escalation
  # path's ONLY data source, so a node-level crash here has to fall through to
  # build-verdict rather than exiting with no verdict at all.
  #
  # Fail CLOSED, though: build-verdict's readJson() swallows a parse error and returns {},
  # which buildVerdict maps to `exitCode: 0` — i.e. an unreadable verify file would be
  # reported as a PASS. An unknown verify result must never read as success, so synthesize
  # an explicit failure instead.
  set +e
  "$NODE_BIN" "$VERDICT_WRITER" run-verify "$WORKTREE_PATH" "$VERIFY_TIMEOUT_MS" 40 "${VERIFY[@]}" > "$VERIFY_RESULTS_PATH"
  RUN_VERIFY_EXIT=$?
  set -e
  if [ "$RUN_VERIFY_EXIT" -ne 0 ] || [ ! -s "$VERIFY_RESULTS_PATH" ]; then
    printf '%s\n' "{\"commands\":[],\"exitCode\":1,\"failedAt\":null,\"tail\":\"run-verify crashed (exit $RUN_VERIFY_EXIT) — verify result unknown, treated as FAIL\"}" > "$VERIFY_RESULTS_PATH"
  fi
fi

build_and_write_verdict
