#!/usr/bin/env bash
# cli-dispatch-clean — remove stale worker session dirs (running-but-dead). Resolves the
# shared engine cli-dispatch-clean.mjs (installed share dir → legacy claude-ds → next to this
# script) and runs it. Default is a DRY-RUN; pass --remove to delete. Used both by hand and by
# the scheduled auto-clean (/cli-dispatch:clean-schedule).
#   cli-dispatch-clean [--remove] [--stale-secs N] [--older-than DAYS] [--quiet]
set -euo pipefail

# launchd/cron run with a minimal PATH (no shell rc sourced) — node installed via a version
# manager or Homebrew is invisible there even though it resolves fine interactively. This is
# the #1 cause of the scheduled auto-clean (/cli-dispatch:clean-schedule) silently failing
# every run. Probe common install locations before giving up.
if ! command -v node >/dev/null 2>&1; then
  for cand in "$HOME/.local/share/fnm/aliases/default/bin" "$HOME/.volta/bin" "$HOME/.asdf/shims" /opt/homebrew/bin /usr/local/bin; do
    [ -x "$cand/node" ] && { PATH="$cand:$PATH"; break; }
  done
  if ! command -v node >/dev/null 2>&1; then
    nvm_dir="${NVM_DIR:-$HOME/.nvm}"
    if [ -d "$nvm_dir/versions/node" ]; then
      latest="$(ls -1 "$nvm_dir/versions/node" 2>/dev/null | sort -V | tail -1)"
      [ -n "$latest" ] && [ -x "$nvm_dir/versions/node/$latest/bin/node" ] && PATH="$nvm_dir/versions/node/$latest/bin:$PATH"
    fi
  fi
fi
command -v node >/dev/null 2>&1 || { echo "cli-dispatch-clean: 'node' not found in PATH (required)." >&2; exit 1; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENGINE="${CLI_DISPATCH_CLEAN_ENGINE:-}"
if [ -z "$ENGINE" ]; then
  for cand in "$HOME/.local/share/cli-dispatch/cli-dispatch-clean.mjs" "$HOME/.local/share/claude-ds/cli-dispatch-clean.mjs" "$SCRIPT_DIR/cli-dispatch-clean.mjs"; do
    if [ -f "$cand" ]; then ENGINE="$cand"; break; fi
  done
fi
[ -n "$ENGINE" ] && [ -f "$ENGINE" ] || { echo "cli-dispatch-clean: cli-dispatch-clean.mjs not found (run /cli-dispatch:setup)." >&2; exit 1; }

exec node "$ENGINE" "$@"
