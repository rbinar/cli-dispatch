{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/policy-inject.mjs\"" }] },
      { "matcher": "resume",  "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/policy-inject.mjs\"" }] },
      { "matcher": "clear",   "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/policy-inject.mjs\"" }] },
      { "matcher": "compact", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/policy-inject.mjs\"" }] },
      { "matcher": "fork",    "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/policy-inject.mjs\"" }] }
    ]
  }
}
